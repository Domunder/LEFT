# Copy this file to .env and fill in the values. Restart the dev server after
# changing it.
#
# Local stack:  run `npm run db:start` in the repo root and use the API URL and
#               publishable key it prints (`npm run db:status` reprints them).
#               Note that 127.0.0.1 is the phone itself when testing on a real
#               device — use your PC's LAN IP, or point at a hosted project.
# Hosted:       Supabase dashboard → Project Settings → API.
#
# The EXPO_PUBLIC_ prefix is what makes these readable at runtime — which also
# means they are embedded in the app bundle. Only ever put the publishable
# (anon) key here. The service-role key must never appear in this file.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Social sign-in (screen 06). See docs/social-sign-in.md for how to obtain
# these. Neither is a secret: OAuth client IDs are public by design and ship
# inside the app bundle either way. The client *secrets* are configured
# server-side in Supabase and must never appear in this file.
# ---------------------------------------------------------------------------

# Google Cloud console -> Credentials. The Web client ID is what Supabase
# validates the ID token against, so it is required on iOS and Android too.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# The iOS OAuth client ID. Its reversed form also goes into app.json's
# @react-native-google-signin plugin config as `iosUrlScheme`.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# ---------------------------------------------------------------------------
# In-app purchases (05.1's paid tiers). See docs/payments.md.
#
# These are RevenueCat's *public* SDK keys (appl_... / goog_...), designed to
# ship in the app bundle — same reasoning as the OAuth client IDs above. The
# secret key (sk_...) can refund purchases and read any customer: it belongs in
# Supabase's function secrets and must never appear in this file.
# ---------------------------------------------------------------------------

EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
