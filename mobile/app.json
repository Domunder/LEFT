{
  "expo": {
    "name": "LEFT",
    "slug": "left",
    "version": "1.2.0",
    "owner": "domundyhd",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "left",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#101010",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.leftmoment.app",
      "appleTeamId": "ZFJBLRVHLD",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:leftmoment.com"
      ],
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.leftmoment.app"
        ]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.leftmoment.app",
      "adaptiveIcon": {
        "backgroundColor": "#101010",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "leftmoment.com",
              "pathPrefix": "/j"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#101010",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "LEFT uses your camera so you can take photos for your event's shared album.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "LEFT needs access to your photos so you can save pictures from your events and add your own.",
          "savePhotosPermission": "LEFT saves pictures from your events to your photo library.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "LEFT needs access to your photos so you can save pictures from your events and add your own.",
          "microphonePermission": false
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.247341244789-t9g88ohse2djb0961no6kcm1hnr754ip"
        }
      ],
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "color": "#101010"
        }
      ],
      "./plugins/with-worklets-headers",
      "expo-sharing",
      "./plugins/with-app-clip",
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "6a69b943-0502-4388-8919-b19cf29fd219"
      }
    }
  }
}
