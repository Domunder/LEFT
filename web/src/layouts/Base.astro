---
import '@fontsource-variable/newsreader/wght.css';
import '@fontsource-variable/newsreader/wght-italic.css';
import '@fontsource-variable/inter/wght.css';
import '@fontsource/dm-serif-display/400.css';
import '../styles/global.css';
import { Image } from 'astro:assets';
import logo from '../assets/left-logo.png';
import { NAV, SITE } from '../site';
// The four faces every page shows above the fold. Preloaded so they are there
// for the first layout: each one that arrives later re-lays the whole page.
import newsreader from '@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url';
import newsreaderItalic from '@fontsource-variable/newsreader/files/newsreader-latin-wght-italic.woff2?url';
import inter from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import dmSerif from '@fontsource/dm-serif-display/files/dm-serif-display-latin-400-normal.woff2?url';

type Props = {
  title: string;
  description: string;
  /** Path of the social card under /public. */
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: object[];
  /** Hide the header's links and CTA (the invite page is one job only). */
  bare?: boolean;
  /**
   * A full-screen app page (the web camera): no header, no footer, no scroll
   * reveal. The page draws all of its own chrome.
   */
  app?: boolean;
  /**
   * Offer the App Clip: Safari shows its card at the top of the page, and
   * "Open" starts the native camera without installing the app.
   */
  appClip?: boolean;
};

const {
  title,
  description,
  ogImage = '/og.jpg',
  noindex = false,
  jsonLd = [],
  bare = false,
  app = false,
  appClip = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogUrl = new URL(ogImage, SITE.url).href;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#101010" />
    {
      appClip && (
        <meta
          name="apple-itunes-app"
          content={`app-id=${SITE.appStoreId}, app-clip-bundle-id=${SITE.appClipBundleId}, app-clip-display=card`}
        />
      )
    }
    {[inter, newsreader, newsreaderItalic, dmSerif].map((href) => (
      <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />
    ))}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
    <script is:inline>
      document.documentElement.classList.add('js');
      if (document.fonts && document.fonts.load) document.documentElement.classList.add('fonts-wait');
    </script>
  </head>
  <body>
    <script is:inline>
      // Hold the first paint until the four preloaded faces are in (350 ms at
      // most). A face that lands after it re-lays the whole document on top
      // of an already visible page — a flash of the fallback font, and the
      // main thread busy exactly when the page first appears.
      (() => {
        const root = document.documentElement;
        if (!root.classList.contains('fonts-wait')) return;
        const show = () => root.classList.remove('fonts-wait');
        Promise.all(
          [
            '300 1em "Newsreader Variable"',
            'italic 300 1em "Newsreader Variable"',
            '400 1em "Inter Variable"',
            '400 1em "DM Serif Display"',
          ].map((face) => document.fonts.load(face)),
        ).then(show, show);
        setTimeout(show, 350);
      })();
    </script>
    {!app && <a class="skip" href="#main">Skip to content</a>}
    {!app && (
    <header class="site-header">
      <nav class="bar glass" aria-label="Main">
        <a class="brand" href="/" aria-label="LEFT, home">
          <Image src={logo} alt="" width={22} height={22} densities={[1, 2, 3]} loading="eager" />
          <span>LEFT</span>
        </a>
        {
          !bare && (
            <>
              <ul class="links">
                {NAV.map((item) => (
                  <li>
                    <a href={item.href}>{item.label}</a>
                  </li>
                ))}
              </ul>
              <a class="pill pill-primary cta" href="/#get">
                Get the app
              </a>
              <details class="menu">
                <summary aria-label="Menu">
                  <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
                    <path d="M3 6.5h14M3 13.5h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                  </svg>
                </summary>
                <ul class="glass">
                  {NAV.map((item) => (
                    <li>
                      <a href={item.href}>{item.label}</a>
                    </li>
                  ))}
                </ul>
              </details>
            </>
          )
        }
      </nav>
    </header>
    )}

    <main id="main">
      <slot />
    </main>

    {!app && (
    <footer class="site-footer">
      <div class="wrap inner">
        <div class="about">
          <a class="brand" href="/" aria-label="LEFT, home">
            <Image src={logo} alt="" width={22} height={22} densities={[1, 2, 3]} />
            <span>LEFT</span>
          </a>
          <p>A disposable camera for events. Photos only, developed together.</p>
        </div>
        <nav aria-label="Footer">
          <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/use-cases/">Use cases</a></li>
            <li><a href="/wedding/">Weddings</a></li>
            <li><a href="/#pricing">Pricing</a></li>
            <li><a href="/#faq">FAQ</a></li>
          </ul>
          <ul>
            <li><a href="/terms/">Terms</a></li>
            <li><a href="/privacy/">Privacy</a></li>
          </ul>
        </nav>
      </div>
      <p class="wrap legal">© {year} LEFT</p>
    </footer>
    )}

    <script is:inline>
      (() => {
        const items = document.querySelectorAll('.reveal, .develop');
        const phones = document.querySelectorAll('.phone');
        const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

        // Each phone's display is a 402pt canvas scaled to the phone's width.
        // The observer reports before the first paint and again when a phone
        // further down is first laid out; reading the widths here instead
        // would force the layout of the whole page, skipped sections included.
        const screens = document.querySelectorAll('.phone .screen');
        const fit = (el, width) => el.style.setProperty('--k', (width / 402).toFixed(4));
        if ('ResizeObserver' in window) {
          const sizes = new ResizeObserver((entries) => {
            for (const entry of entries) fit(entry.target, entry.contentRect.width);
          });
          screens.forEach((el) => sizes.observe(el));
        } else {
          screens.forEach((el) => fit(el, el.clientWidth));
        }
        if (!('IntersectionObserver' in window)) {
          items.forEach((el) => el.classList.add('in'));
          phones.forEach((el) => el.classList.add('live'));
          return;
        }

        // Arrivals: things that come in together are staggered.
        const io = new IntersectionObserver(
          (entries) => {
            let order = 0;
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.style.setProperty('--d', `${Math.min(order++, 5) * 90}ms`);
              entry.target.classList.add('in');
              io.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        items.forEach((el) => io.observe(el));

        // A phone's screen only moves while it is on screen.
        const typing = new WeakMap();
        const type = (phone) => {
          const field = phone.querySelector('[data-type]');
          if (!field || typing.has(phone)) return;
          const text = field.dataset.type;
          if (still) return void (field.textContent = text);
          let shown = 0;
          field.textContent = '';
          typing.set(
            phone,
            setInterval(() => {
              field.textContent = text.slice(0, ++shown);
              if (shown >= text.length) clearInterval(typing.get(phone));
            }, 190),
          );
        };
        const shooting = new WeakMap();
        const shoot = (phone, on) => {
          const count = phone.querySelector('[data-count]');
          if (!count || still) return;
          clearInterval(shooting.get(phone));
          if (!on) return;
          const start = Number(count.dataset.count);
          let left = Number(count.textContent) || start;
          shooting.set(
            phone,
            setInterval(() => {
              left = left > start - 5 ? left - 1 : start;
              phone.classList.remove('shot');
              requestAnimationFrame(() => requestAnimationFrame(() => phone.classList.add('shot')));
              setTimeout(() => (count.textContent = String(left)), 140);
            }, 3600),
          );
        };
        const ticking = new WeakMap();
        const tick = (phone, on) => {
          const seconds = phone.querySelector('[data-tick]');
          if (!seconds || still) return;
          clearInterval(ticking.get(phone));
          if (!on) return;
          ticking.set(
            phone,
            setInterval(() => {
              const next = (Number(seconds.textContent) + 59) % 60;
              seconds.textContent = String(next).padStart(2, '0');
            }, 1000),
          );
        };
        const live = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              entry.target.classList.toggle('live', entry.isIntersecting);
              if (entry.isIntersecting) type(entry.target);
              shoot(entry.target, entry.isIntersecting);
              tick(entry.target, entry.isIntersecting);
            }
          },
          { threshold: 0.35 },
        );
        phones.forEach((el) => live.observe(el));

        if (still) return;

        // Scroll-linked pieces: parallax drift and the two photo rows.
        const drifting = [...document.querySelectorAll('[data-parallax]')];
        const reels = [...document.querySelectorAll('[data-reel]')];
        if (!drifting.length && !reels.length) return;
        let queued = false;
        const frame = () => {
          queued = false;
          const height = innerHeight;
          for (const el of drifting) {
            const box = el.parentElement.getBoundingClientRect();
            if (box.bottom < -200 || box.top > height + 200) continue;
            const offset = (box.top + box.height / 2 - height / 2) * Number(el.dataset.parallax);
            el.style.translate = `0 ${offset.toFixed(1)}px`;
          }
          for (const reel of reels) {
            const box = reel.getBoundingClientRect();
            if (box.bottom < 0 || box.top > height) continue;
            const progress = Math.min(1, Math.max(0, (height - box.top) / (height + box.height)));
            for (const row of reel.children) {
              const spare = row.scrollWidth - reel.clientWidth;
              const along = row.dataset.dir === 'back' ? 1 - progress : progress;
              row.style.transform = `translate3d(${(-spare * along).toFixed(1)}px,0,0)`;
            }
          }
        };
        const queue = () => {
          if (queued) return;
          queued = true;
          requestAnimationFrame(frame);
        };
        addEventListener('scroll', queue, { passive: true });
        addEventListener('resize', queue, { passive: true });
        queue();
      })();
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 16px;
    top: -60px;
    z-index: 100;
    background: var(--ink);
    color: var(--ink-dark);
    padding: 10px 16px;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 600;
  }
  .skip:focus {
    top: 12px;
  }

  .site-header {
    position: fixed;
    inset: 14px 0 auto 0;
    z-index: 50;
    display: flex;
    justify-content: center;
    padding-inline: 14px;
    pointer-events: none;
  }

  .bar {
    pointer-events: auto;
    width: min(1160px, 100%);
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 8px 8px 8px 20px;
    border-radius: 999px;
    min-height: 56px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    text-decoration: none;
    font-weight: 600;
    letter-spacing: 0.06em;
    margin-right: auto;
  }

  .links {
    display: flex;
    gap: 28px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .links a {
    text-decoration: none;
    font-size: 0.9rem;
    color: var(--ink-70);
    transition: color 0.2s var(--ease);
  }

  .links a:hover {
    color: var(--ink);
  }

  .cta {
    min-height: 40px;
    padding: 10px 18px;
    font-size: 0.875rem;
  }

  .menu {
    display: none;
    position: relative;
  }

  .menu summary {
    list-style: none;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    cursor: pointer;
  }

  .menu summary::-webkit-details-marker {
    display: none;
  }

  .menu ul {
    position: absolute;
    right: -8px;
    top: 54px;
    width: min(260px, 80vw);
    list-style: none;
    margin: 0;
    padding: 10px;
    border-radius: 22px;
    background: rgba(20, 18, 16, 0.92);
  }

  .menu a {
    display: block;
    padding: 12px 14px;
    text-decoration: none;
    border-radius: 12px;
  }

  @media (max-width: 760px) {
    .links {
      display: none;
    }
    .menu {
      display: block;
    }
    .bar {
      gap: 8px;
    }
  }

  .site-footer {
    border-top: 1px solid var(--line);
    padding-block: 56px 36px;
    color: var(--ink-70);
    font-size: 0.9rem;
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 36px;
  }

  .about {
    display: grid;
    gap: 14px;
    max-width: 30ch;
  }

  .about .brand {
    color: var(--ink);
    margin-right: 0;
  }

  .site-footer nav {
    display: flex;
    gap: 64px;
  }

  .site-footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 4px;
    align-content: start;
  }

  .site-footer nav a {
    display: inline-block;
    padding-block: 6px;
    text-decoration: none;
  }

  .site-footer nav a:hover {
    color: var(--ink);
  }

  .legal {
    margin-top: 48px;
    color: var(--ink-55);
    font-size: 0.8rem;
  }
</style>
