---
/**
 * PLACEHOLDER. The legal texts are rewritten for photos and reviewed in M6
 * (docs/MILESTONES.md); until then these URLs exist so the app and the stores
 * have something to link to, and they stay out of the index. Do not write
 * legal text here by hand — it comes from the reviewed source.
 */
import Base from '../layouts/Base.astro';

type Props = { kind: 'Terms of Use' | 'Privacy Policy' };
const { kind } = Astro.props;
---

<Base title={`${kind} — LEFT`} description={`The ${kind} of LEFT, the disposable camera app for events.`} noindex>
  <section class="legal">
    <div class="wrap inner">
      <p class="eyebrow">Legal</p>
      <h1>{kind}</h1>
      <p class="lede">
        This page will hold LEFT’s {kind} before the app is released. The final text is being prepared and is not
        published yet.
      </p>
      <p><a class="text-link" href="/">Back to LEFT →</a></p>
    </div>
  </section>
</Base>

<style>
  .legal {
    padding-top: clamp(140px, 18vw, 200px);
    min-height: 70svh;
  }

  .inner {
    display: grid;
    gap: 22px;
    max-width: 760px;
  }
</style>
