  }

  .phone.shot .flash {
    animation: blink 0.6s ease-out;
  }

  .phone.shot .roll b {
    animation: land 0.6s var(--ease);
  }

  @keyframes press {
    30% {
      transform: scale(0.84);
    }
  }

  @keyframes blink {
    18% {
      opacity: 0.9;
    }
  }

  @keyframes land {
    25% {
      transform: translateY(-14%);
      opacity: 0.3;
    }
  }

  /* ── 03 Film ──────────────────────────────────────────────────── */
  .looks {
    padding-inline: calc(var(--u) * 28);
    background:
      radial-gradient(calc(var(--u) * 420) calc(var(--u) * 420) at 10% -8%, rgba(240, 190, 140, 0.17), transparent 70%),
      #101010;
  }

  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: calc(var(--u) * 38);
    flex: none;
  }

  .steps {
    display: flex;
  }

  .steps i {
    width: calc(var(--u) * 24);
    height: calc(var(--u) * 5);
    display: grid;
    place-items: center;
  }

  .steps i::before {
    content: '';
    width: calc(var(--u) * 6);
    height: calc(var(--u) * 5);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
  }

  .steps i.done::before {
    background: rgba(240, 237, 232, 0.3);
  }

  .steps i.on::before {
    width: 100%;
    background: #f0ede8;
  }

  .looks .eyebrow-s {
    margin-top: calc(var(--u) * 36);
  }

  .looks .headline {
    margin-top: calc(var(--u) * 14);
  }

  .cards {
    flex: 1;
    min-height: 0;
    margin-top: calc(var(--u) * 30);
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: calc(var(--u) * 12);
  }

  .card {
    position: relative;
    border-radius: calc(var(--u) * 18);
    overflow: hidden;
    background: #141316;
    box-shadow: inset 0 0 0 calc(var(--u) * 1) rgba(255, 255, 255, 0.07);
    opacity: 0.6;
  }

  .card.on {
    opacity: 1;
  }

  .card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    border: calc(var(--u) * 1.5) solid rgba(240, 237, 232, 0);
  }

  .card.on::after {
    border-color: rgba(240, 237, 232, 0.6);
  }

  .card-text {
    position: absolute;
    inset: auto 0 0 0;
    padding: calc(var(--u) * 50) calc(var(--u) * 14) calc(var(--u) * 14);
    background: linear-gradient(rgba(8, 8, 10, 0), rgba(8, 8, 10, 0.55) 50%, rgba(8, 8, 10, 0.9));
    display: grid;
    gap: calc(var(--u) * 3);
  }

  .card b {
    font-family: var(--serif);
