  }

  .finder > :global(img) {
    position: absolute;
    inset: 0;
  }

  .scrim-top,
  .scrim-bottom {
    position: absolute;
    inset-inline: 0;
    pointer-events: none;
  }

  .scrim-top {
    top: 0;
    height: calc(var(--u) * 192);
    background: linear-gradient(rgba(0, 0, 0, 0.45), rgba(0, 0, 0, 0));
  }

  .scrim-bottom {
    bottom: 0;
    height: calc(var(--u) * 110);
    background: linear-gradient(rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.4));
  }

  .cam-head {
    position: absolute;
    inset: 0 0 auto;
    display: grid;
    grid-template-columns: calc(var(--u) * 76) 1fr calc(var(--u) * 76);
