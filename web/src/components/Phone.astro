    color: rgba(240, 237, 232, 0.3);
  }

  .roll {
    display: flex;
    align-items: baseline;
    gap: calc(var(--u) * 6);
  }

  .roll b {
    font-family: var(--numeral);
    font-weight: 400;
    font-size: calc(var(--u) * 34);
    line-height: calc(var(--u) * 38);
    font-variant-numeric: tabular-nums;
  }

  .roll small {
    font-size: calc(var(--u) * 12);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(240, 237, 232, 0.55);
  }

  .tile {
    width: calc(var(--u) * 46);
    height: calc(var(--u) * 46);
    border-radius: calc(var(--u) * 12);
    overflow: hidden;
    display: grid;
    place-items: center;
  }

  .tile svg {
    width: calc(var(--u) * 22);
    height: calc(var(--u) * 22);
    stroke-width: 1.7;
  }

  .zoom {
