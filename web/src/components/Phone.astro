      </div>
      <span class="home"></span>
    </div>
  </div>
  {android && <span class="droid-body"><i /><i /></span>}
  <Image
    src={frame}
    alt=""
    class:list={['frame', { off: android }]}
    widths={detail > 1 ? [960, device.framePngWidth] : [320, 480, 640, 960]}
    sizes={detail > 1 ? '100vw' : '(min-width: 900px) 300px, 70vw'}
