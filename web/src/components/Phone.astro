---
/**
 * An iPhone showing one LEFT screen. The screens are redrawn in HTML/CSS from
 * the app's own layouts (mobile/src/app, sizes in points) — not screenshots.
 *
 * Everything on the screen is sized in `--u`, one point of a 393pt-wide
 * display, and the whole display is scaled to the phone, so it stays one
 * picture at any size. The body adds a 10pt black bezel and a 5pt titanium
 * band around it.
 *
 * The figure gets `.live` while it is on screen and the script in Base.astro
 * drives the small loops (`data-count`, `data-tick`, `data-type`); every
 * animation here hangs off `.live`, so an off-screen phone is still.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import weddingDance from '../assets/photos/wedding-dance.jpg';
import weddingCrowd from '../assets/photos/wedding-crowd.jpg';
import weddingFriends from '../assets/photos/wedding-friends.jpg';
import weddingMono from '../assets/photos/wedding-mono.jpg';
import partyFlash from '../assets/photos/party-flash.jpg';
import partyWine from '../assets/photos/party-wine.jpg';
import birthdayCandle from '../assets/photos/birthday-candle.jpg';
import dinnerCandle from '../assets/photos/dinner-candle.jpg';
import tripTrunk from '../assets/photos/trip-trunk.jpg';
import sample2 from '../assets/photos/sample-2.jpg';
import { LOOKS } from '../site';

type Props = {
  screen: 'camera' | 'looks' | 'moments' | 'album' | 'join' | 'developing';
  label: string;
  /** The picture in the viewfinder / on the front print. */
  photo?: ImageMetadata;
  title?: string;
  shotsLeft?: number;
  eager?: boolean;
  class?: string;
};

const {
  screen,
  label,
  photo = weddingDance,
  title = 'Mia & Jonas',
  shotsLeft = 17,
  eager = false,
  class: className,
} = Astro.props;

const loading = eager ? 'eager' : 'lazy';
const grid = [
  weddingFriends,
  weddingDance,
  partyFlash,
  dinnerCandle,
  weddingCrowd,
  birthdayCandle,
  weddingMono,
  partyWine,
  tripTrunk,
  sample2,
  weddingDance,
  partyFlash,
];

/** Feather icons (24 grid, stroked), the set the app uses. */
const ICON = {
  x: 'M18 6L6 18M6 6l12 12',
  zap: 'M13 2L3 14h9l-1 8 10-12h-9l1-8z',
  flip: 'M23 4v6h-6M1 20v-6h6M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15',
  back: 'M15 18l-6-6 6-6',
  next: 'M9 18l6-6-6-6',
  plus: 'M12 5v14M5 12h14',
  users:
    'M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2M9 11a4 4 0 100-8 4 4 0 000 8zM23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75',
  sliders: 'M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6',
  download: 'M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3',
  camera:
    'M23 19a2 2 0 01-2 2H3a2 2 0 01-2-2V8a2 2 0 012-2h4l2-3h6l2 3h4a2 2 0 012 2zM12 17a4 4 0 100-8 4 4 0 000 8z',
  arrow: 'M5 12h14M12 5l7 7-7 7',
  qr: 'M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h3v3h-3zM18 18h3v3h-3zM18 14h3M14 18v3',
};
---

<figure class:list={['phone', className]} role="img" aria-label={label}>
  <span class="key k-action"></span>
  <span class="key k-up"></span>
  <span class="key k-down"></span>
  <span class="key k-power"></span>
  <div class="bezel">
    <div class="screen" aria-hidden="true">
      <div class="canvas">
      {
        screen === 'camera' && (
          <div class="s camera">
            <div class="cam-head">
              <span class="round glass">
                <svg viewBox="0 0 24 24"><path d={ICON.x} /></svg>
              </span>
              <span class="eyebrow-s">{title}</span>
              <span class="until">
                <b>01</b><small>D</small><b class="dim">04</b><small>H</small>
              </span>
            </div>
            <div class="finder-fit">
              <div class="finder">
                <Image
                  src={photo}
                  alt=""
                  width={720}
                  height={960}
                  fit="cover"
                  quality={64}
                  loading={loading}
                  fetchpriority={eager ? 'high' : 'auto'}
                  class="look-golden"
                />
                <div class="row row-top">
                  <span class="round lg glass">
                    <svg viewBox="0 0 24 24"><path d={ICON.zap} /></svg>
                  </span>
                  <span class="roll glass">
                    <b data-count={shotsLeft}>{shotsLeft}</b>
                    <small>Left</small>
                  </span>
                  <span class="round lg glass">
                    <svg viewBox="0 0 24 24"><path d={ICON.flip} /></svg>
                  </span>
                </div>
                <div class="row row-bottom">
                  <span class="tile glass">
                    <Image src={weddingFriends} alt="" width={140} height={140} fit="cover" quality={55} loading={loading} class="look-golden" />
                  </span>
                  <span class="zoom glass">
                    <i>0.5×</i><i class="on">1×</i><i>3×</i>
                  </span>
                  <span class="tile glass">
                    <svg viewBox="0 0 24 24"><path d={ICON.qr} /></svg>
                  </span>
                </div>
                <span class="flash" />
              </div>
            </div>
            <div class="shutter-bar">
              <span class="shutter"><i /></span>
            </div>
          </div>
        )
      }

      {
        screen === 'looks' && (
          <div class="s looks">
            <div class="head">
              <span class="round flat">
                <svg viewBox="0 0 24 24"><path d={ICON.back} /></svg>
              </span>
              <span class="steps">
                <i class="done" /><i class="on" /><i /><i />
              </span>
              <span class="round" />
            </div>
            <span class="eyebrow-s wide">Film</span>
            <p class="headline">
              Which film are<br /><em>you loading?</em>
            </p>
            <div class="cards">
              {LOOKS.map((look, index) => (
                <div class:list={['card', { on: index === 0 }]} style={`--n:${index}`}>
                  <Image src={photo} alt="" width={340} height={425} fit="cover" quality={58} loading={loading} class={`look-${look.id}`} />
                  <span class="card-text">
                    <b>{look.name}</b>
                    <small>{look.blurb}</small>
                  </span>
                </div>
              ))}
            </div>
            <span class="cta">
              <svg viewBox="0 0 24 24"><path d={ICON.arrow} /></svg>
              Continue
            </span>
          </div>
        )
      }

      {
        screen === 'moments' && (
          <div class="s moments">
            <Image src={photo} alt="" width={60} height={130} fit="cover" quality={40} loading={loading} class="wash" />
            <div class="lib-head">
              <p class="headline sm">Your Moments</p>
              <span class="round lg glass">
                <svg viewBox="0 0 24 24"><path d={ICON.sliders} /></svg>
              </span>
              <span class="round lg glass">
                <svg viewBox="0 0 24 24"><path d={ICON.users} /></svg>
              </span>
              <span class="round lg light">
                <svg viewBox="0 0 24 24"><path d={ICON.plus} /></svg>
              </span>
            </div>
            <div class="stack">
              <span class="print far">
                <Image src={weddingCrowd} alt="" width={400} height={640} fit="cover" quality={50} loading={loading} class="look-golden" />
              </span>
              <span class="print near">
                <Image src={weddingFriends} alt="" width={400} height={640} fit="cover" quality={50} loading={loading} class="look-golden" />
              </span>
              <span class="print front">
                <Image src={photo} alt="" width={600} height={960} fit="cover" quality={62} loading={loading} class="look-golden" />
                <span class="caption">
                  <b>{title}</b>
                  <span class="caps">
                    <span class="cap glass">
                      Developed · 412 photos
                      <svg viewBox="0 0 24 24"><path d={ICON.next} /></svg>
                    </span>
                    <span class="cap glass">
                      <svg viewBox="0 0 24 24"><path d={ICON.users} /></svg>
                      38
                    </span>
                  </span>
                </span>
              </span>
              <span class="print peek" />
            </div>
            <span class="pages">
              <i class="on" /><i /><i />
            </span>
          </div>
        )
      }

      {
        screen === 'album' && (
          <div class="s album">
            <div class="album-scroll">
              <p class="headline">{title}</p>
              <p class="meta">412 photos · 38 people</p>
              <div class="grid">
                {grid.map((image, index) => (
                  <span style={`--n:${index}`}>
                    <Image src={image} alt="" width={210} height={280} fit="cover" quality={52} loading={loading} class="look-golden" />
                  </span>
                ))}
              </div>
            </div>
            <span class="fade" />
            <div class="float">
              <span class="round lg glass">
                <svg viewBox="0 0 24 24"><path d={ICON.back} /></svg>
              </span>
              <span class="cap glass">
                <svg viewBox="0 0 24 24"><path d={ICON.download} /></svg>
                Save all
              </span>
            </div>
          </div>
        )
      }

      {
        screen === 'join' && (
          <div class="s join">
            <span class="eyebrow-s wide">Welcome</span>
            <p class="headline xl">
              What should<br />we <em>call you?</em>
            </p>
            <span class="field">
              <span data-type="Lena">Lena</span>
            </span>
            <p class="helper">This is how the group will see you during the event.</p>
            <span class="cta">Continue</span>
          </div>
        )
      }

      {
        screen === 'developing' && (
          <div class="s developing">
            <div class="float">
              <span class="round lg glass">
                <svg viewBox="0 0 24 24"><path d={ICON.back} /></svg>
              </span>
            </div>
            <div class="dev-body">
              <span class="eyebrow-s wide">{title}</span>
              <p class="headline">
                Nothing to see<br /><em>yet.</em>
              </p>
              <p class="clock">
                <b>04</b><small>h</small><b>12</b><small>m</small><b data-tick>48</b><small>s</small>
              </p>
              <p class="meta">
                412 photos so far, from 38 people.<br />They appear together when the film is developed.
              </p>
              <div class="frames">
                {[0, 1, 2, 3, 4].map((index) => (
                  <i style={`--n:${index}`} />
                ))}
              </div>
            </div>
            <span class="cta">
              <svg viewBox="0 0 24 24"><path d={ICON.camera} /></svg>
              Back to the camera
            </span>
          </div>
        )
      }

      <div class="status">
        <span class="time">9:41</span>
        <span class="sys">
          <svg viewBox="0 0 18 12" class="fill">
            <rect x="0" y="8" width="3" height="4" rx="0.8" />
            <rect x="5" y="5.4" width="3" height="6.6" rx="0.8" />
            <rect x="10" y="2.8" width="3" height="9.2" rx="0.8" />
            <rect x="15" y="0" width="3" height="12" rx="0.8" />
          </svg>
          <svg viewBox="0 0 17 12" class="line">
            <path d="M1.4 4.4a10.2 10.2 0 0114.2 0M4 7.1a6.5 6.5 0 019 0" />
            <circle cx="8.5" cy="10" r="1.4" />
          </svg>
          <svg viewBox="0 0 27 13" class="battery">
            <rect x="0.5" y="0.5" width="22" height="12" rx="3.8" />
            <rect x="2" y="2" width="19" height="9" rx="2.4" />
            <rect x="24" y="4.3" width="2" height="4.4" rx="1" />
          </svg>
        </span>
      </div>
      <span class="island"><i></i></span>
      <span class="home"></span>
      </div>
    </div>
    <span class="glare"></span>
  </div>
</figure>

<style>
  /* ── The hardware ─────────────────────────────────────────────── */
  .phone {
    position: relative;
    isolation: isolate;
    margin: 0;
    width: 100%;
    max-width: 300px;
    aspect-ratio: 423 / 882;
    padding: 1.182%;
    border-radius: 16.55% / 7.94%;
    /* Brushed titanium: light along the top-left edge, darker through the turn. */
    background: linear-gradient(
      145deg,
      #a39d94 0%,
      #55514c 14%,
      #8d877f 30%,
      #3c3936 52%,
      #7b766f 72%,
      #2f2d2b 88%,
      #6d6862 100%
    );
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.18),
      0 0 0 1px rgba(0, 0, 0, 0.7),
      0 2px 4px rgba(0, 0, 0, 0.5),
      0 36px 60px -22px rgba(0, 0, 0, 0.85);
  }

  .key {
    position: absolute;
    z-index: -1;
    width: 1.1%;
    border-radius: 2px;
    background: linear-gradient(90deg, #4a4642, #8f8981 50%, #3a3734);
  }

  .k-action,
  .k-up,
  .k-down {
    left: -0.75%;
  }

  .k-power {
    right: -0.75%;
    top: 30.5%;
    height: 11%;
    background: linear-gradient(270deg, #4a4642, #8f8981 50%, #3a3734);
  }

  .k-action {
    top: 19.2%;
    height: 3.6%;
  }

  .k-up {
    top: 26.2%;
    height: 6.8%;
  }

  .k-down {
    top: 34.6%;
    height: 6.8%;
  }

  .bezel {
    position: relative;
    width: 100%;
    height: 100%;
    padding: 2.421%;
    border-radius: 15.74% / 7.45%;
    background: #050505;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.07);
  }

  /* Off-screen phones skip layout; the frame fixes the size, so nothing shifts. */
  .screen {
    content-visibility: auto;
    container-type: inline-size;
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 14% / 6.455%;
    overflow: hidden;
    background: #101010;
    color: #f0ede8;
    font-family: var(--sans);
  }

  /*
    The display is drawn once at 393x852 and scaled to the phone (`--k`, set
    by the script in Base.astro): a re-layout of the page then costs these
    screens nothing. Without JS the same CSS runs on container units instead.
  */
  .canvas {
    position: absolute;
    inset: 0;
    --u: calc(100cqw / 393);
  }

  :global(.js) .screen {
    container-type: normal;
  }

  :global(.js) .canvas {
    inset: 0 auto auto 0;
    width: 393px;
    height: 852px;
    --u: 1px;
    transform-origin: 0 0;
    transform: scale(var(--k, 0.7));
  }

  /* The glass over the display: one soft reflection from the top-left. */
  .glare {
    position: absolute;
    inset: 2.421%;
    border-radius: 14% / 6.455%;
    pointer-events: none;
    background: linear-gradient(118deg, rgba(255, 255, 255, 0.1) 0%, rgba(255, 255, 255, 0.03) 22%, transparent 38%);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.05);
  }

  .status {
    position: absolute;
    inset: 0 0 auto 0;
    height: calc(var(--u) * 54);
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: calc(var(--u) * 5);
    font-family: -apple-system, 'SF Pro Text', 'Inter Variable', system-ui, sans-serif;
    pointer-events: none;
  }

  .time,
  .sys {
    width: calc(var(--u) * 133);
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .time {
    font-size: calc(var(--u) * 17);
    font-weight: 600;
    letter-spacing: -0.02em;
    padding-left: calc(var(--u) * 6);
  }

  .sys {
    gap: calc(var(--u) * 6);
    padding-right: calc(var(--u) * 6);
  }

  .sys svg {
    height: calc(var(--u) * 12);
    width: auto;
  }

  .sys .fill {
    fill: currentColor;
  }

  .sys .line {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
  }

  .sys .line circle {
    fill: currentColor;
    stroke: none;
  }

  .sys .battery {
    height: calc(var(--u) * 13);
    fill: currentColor;
  }

  .battery rect:first-child {
    fill: none;
    stroke: currentColor;
    stroke-opacity: 0.4;
  }

  .battery rect:last-child {
    fill-opacity: 0.45;
  }

  .island {
    position: absolute;
    top: calc(var(--u) * 11);
    left: 50%;
    width: calc(var(--u) * 124);
    height: calc(var(--u) * 36);
    margin-left: calc(var(--u) * -62);
    border-radius: 999px;
    background: #000;
  }

  .island i {
    position: absolute;
    right: calc(var(--u) * 12);
    top: 50%;
    width: calc(var(--u) * 11);
    height: calc(var(--u) * 11);
    margin-top: calc(var(--u) * -5.5);
    border-radius: 50%;
    background: radial-gradient(circle at 38% 36%, #2b3350, #0a0c16 60%);
    box-shadow: 0 0 0 calc(var(--u) * 1) rgba(255, 255, 255, 0.04);
  }

  .home {
    position: absolute;
    left: 50%;
    bottom: calc(var(--u) * 8);
    width: calc(var(--u) * 136);
    height: calc(var(--u) * 5);
    margin-left: calc(var(--u) * -68);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.92);
  }

  /* ── Shared screen pieces ─────────────────────────────────────── */
  .s {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    padding: calc(var(--u) * 59) 0 calc(var(--u) * 34);
    font-size: calc(var(--u) * 14);
    line-height: 1.35;
  }

  .s :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .s svg {
    width: calc(var(--u) * 16);
    height: calc(var(--u) * 16);
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex: none;
  }

  /*
    Liquid Glass stands in as the app's tinted fill, a little denser and with
    no backdrop blur: at this size the blur is invisible, and a dozen of them
    per phone is real work for a handset's GPU.
  */
  .glass {
    background: rgba(30, 27, 25, 0.62);
    box-shadow:
      inset 0 0 0 calc(var(--u) * 1) rgba(255, 255, 255, 0.16),
      inset 0 calc(var(--u) * 1) 0 rgba(255, 255, 255, 0.14);
  }

  .round {
    width: calc(var(--u) * 38);
    height: calc(var(--u) * 38);
    border-radius: 50%;
    display: grid;
    place-items: center;
    flex: none;
    color: rgba(240, 237, 232, 0.7);
  }

  .round.lg {
    width: calc(var(--u) * 44);
    height: calc(var(--u) * 44);
  }

  .round.lg svg {
    width: calc(var(--u) * 18);
    height: calc(var(--u) * 18);
  }

  .round.flat {
    background: rgba(255, 255, 255, 0.08);
  }

  .round.light {
    background: #f0ede8;
    color: #0b0b0c;
  }

  .headline {
    font-family: var(--serif);
    font-weight: 300;
    font-size: calc(var(--u) * 38);
    line-height: calc(var(--u) * 44);
    letter-spacing: -0.015em;
  }

  .headline.sm {
    font-size: calc(var(--u) * 32);
    line-height: calc(var(--u) * 37);
  }

  .headline.xl {
    font-size: calc(var(--u) * 40);
    line-height: calc(var(--u) * 46);
  }

  .eyebrow-s {
    font-size: calc(var(--u) * 11);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(240, 237, 232, 0.32);
  }

  .eyebrow-s.wide {
    font-size: calc(var(--u) * 12);
    font-weight: 500;
    letter-spacing: 0.14em;
  }

  .meta {
    color: rgba(240, 237, 232, 0.42);
    font-size: calc(var(--u) * 13);
    line-height: calc(var(--u) * 21);
  }

  .cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: calc(var(--u) * 8);
    height: calc(var(--u) * 54);
    border-radius: 999px;
    background: #f0ede8;
    color: #0b0b0c;
    font-weight: 500;
    font-size: calc(var(--u) * 16);
    letter-spacing: -0.01em;
    flex: none;
    box-shadow:
      inset 0 calc(var(--u) * 1) 0 rgba(255, 255, 255, 0.8),
      0 calc(var(--u) * 2) calc(var(--u) * 6) rgba(0, 0, 0, 0.3);
  }

  .cap {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--u) * 7);
    height: calc(var(--u) * 36);
    padding-inline: calc(var(--u) * 14);
    border-radius: 999px;
    font-size: calc(var(--u) * 11);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .cap svg {
    width: calc(var(--u) * 13);
    height: calc(var(--u) * 13);
  }

  .float {
    position: absolute;
    inset: calc(var(--u) * 71) calc(var(--u) * 12) auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  /* ── 13 Camera ────────────────────────────────────────────────── */
  .cam-head {
    display: grid;
    grid-template-columns: calc(var(--u) * 76) 1fr calc(var(--u) * 76);
    align-items: center;
    padding: calc(var(--u) * 8) calc(var(--u) * 20) calc(var(--u) * 12);
    flex: none;
  }

  .cam-head .eyebrow-s {
    text-align: center;
  }

  .until {
    display: flex;
    justify-content: flex-end;
    align-items: baseline;
    gap: calc(var(--u) * 2);
  }

  .until b {
    font-family: var(--numeral);
    font-weight: 400;
    font-size: calc(var(--u) * 16);
  }

  .until b.dim {
    color: rgba(240, 237, 232, 0.55);
    margin-left: calc(var(--u) * 6);
  }

  .until small {
    font-size: calc(var(--u) * 9);
    font-weight: 600;
    color: rgba(240, 237, 232, 0.3);
  }

  .finder-fit {
    flex: 1;
    min-height: 0;
    display: grid;
    place-items: center;
