    justify-content: space-between;
    align-items: center;
    padding: calc(var(--u) * 14) calc(var(--u) * 24) calc(var(--u) * 6);
    flex: none;
  }

  .shutter {
    width: calc(var(--u) * 76);
    height: calc(var(--u) * 76);
