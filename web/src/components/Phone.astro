    padding: calc(var(--u) * 70) calc(var(--u) * 20) 0;
  }

  .cam-title {
    display: grid;
    justify-items: center;
    gap: calc(var(--u) * 2);
  }

  .cam-title .eyebrow-s {
    color: rgba(240, 237, 232, 0.6);
  }

  .until {
    display: flex;
    justify-content: flex-end;
    align-items: baseline;
    gap: calc(var(--u) * 2);
    padding-top: calc(var(--u) * 12);
  }

  .until svg {
    align-self: center;
    width: calc(var(--u) * 12);
    height: calc(var(--u) * 12);
    color: rgba(240, 237, 232, 0.55);
  }

  /* "Missions 1/3" under the counter. */
  .m-cap {
    display: flex;
    align-items: center;
    gap: calc(var(--u) * 5);
    height: calc(var(--u) * 28);
    padding-inline: calc(var(--u) * 11);
    margin-top: calc(var(--u) * 6);
    border-radius: 999px;
    font-size: calc(var(--u) * 12);
    font-weight: 600;
    white-space: nowrap;
  }

  .m-cap svg {
    width: calc(var(--u) * 12);
