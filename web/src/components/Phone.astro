    gap: calc(var(--u) * 6);
    padding: calc(var(--u) * 7) calc(var(--u) * 8) calc(var(--u) * 7) calc(var(--u) * 12);
    border-radius: calc(var(--u) * 16);
    background: rgba(0, 0, 0, 0.52);
    box-shadow: inset 0 0 0 calc(var(--u) * 1) rgba(255, 255, 255, 0.09);
