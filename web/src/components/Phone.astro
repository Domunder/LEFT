---
/**
 * An iPhone 17 Pro showing one LEFT screen.
 *
 * The body is a real frame: the PNG and the display's geometry come from
 * Mockify (@mockifydev/react, MIT — frames from Apple's design resources).
 * Only its assets and device config are used, not its React component: that
 * one takes a fixed pixel width, and this site has no React on the page. The
 * frame carries the bezel, the keys and the Dynamic Island; the display lies
 * under it.
 *
 * The screens are redrawn in HTML/CSS from the app's own layouts
 * (mobile/src/app, sizes in points) — not screenshots. Everything on a screen
 * is sized in `--u`, one point of the 402pt-wide display, and the whole
 * display is scaled to the phone, so it stays one picture at any size.
 *
 * The figure gets `.live` while it is on screen and the script in Base.astro
 * drives the small loops (`data-count`, `data-tick`); every
 * animation here hangs off `.live`, so an off-screen phone is still.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import weddingDance from '../assets/photos/wedding-dance.jpg';
import weddingCrowd from '../assets/photos/wedding-crowd.jpg';
import weddingMono from '../assets/photos/wedding-mono.jpg';
import partyWine from '../assets/photos/party-wine.jpg';
import birthdayCandle from '../assets/photos/birthday-candle.jpg';
import dinnerCandle from '../assets/photos/dinner-candle.jpg';
import sample2 from '../assets/photos/sample-2.jpg';
import sample3 from '../assets/photos/sample-3.jpg';
import partyToast from '../assets/photos/party-toast.jpg';
import partyDance from '../assets/photos/party-dance.jpg';
import friendsLaugh from '../assets/photos/friends-laugh.jpg';
import partyConfetti from '../assets/photos/party-confetti.jpg';
import dinnerTable from '../assets/photos/dinner-table.jpg';
import tripSunset from '../assets/photos/trip-sunset.jpg';
import weddingToast from '../assets/photos/wedding-toast.jpg';
import weddingChampagne from '../assets/photos/wedding-champagne.jpg';
import weddingNight from '../assets/photos/wedding-night.jpg';
import partyFloor from '../assets/photos/party-floor.jpg';
import tripCar from '../assets/photos/trip-car.jpg';
import tripFriends from '../assets/photos/trip-friends.jpg';
import tripSurf from '../assets/photos/trip-surf.jpg';
import tripVan from '../assets/photos/trip-van.jpg';
import { iPhone17Pro as device } from '@mockifydev/react';
// A relative path: the package's `exports` only names its entry point.
import frame from '../../node_modules/@mockifydev/react/assets/devices/iPhone 17 Pro - Silver.png';
import QRCode from 'qrcode';
import { LOOKS, SITE } from '../site';

type Props = {
  screen: 'camera' | 'looks' | 'moments' | 'album' | 'invite' | 'developing' | 'missions' | 'viewer';
  label: string;
  /** The picture in the viewfinder / on the front print. */
  photo?: ImageMetadata;
  title?: string;
  shotsLeft?: number;
  eager?: boolean;
  /**
   * Scales the resolution of every picture (not its size on the page). The
   * site leaves it at 1; the store screenshots (src/store/Shot.astro) are
   * rendered at three device pixels per point and ask for more.
   */
  detail?: number;
  /**
   * The handset. 'android' is drawn in CSS (Mockify only has iPhones): even
   * bezels, a punch-hole camera, Android's status bar and gesture pill. The
   * screens themselves stay the same layouts. Used for Google Play's pictures.
   */
  device?: 'iphone' | 'android';
  /** The last shot, on the tile left of the shutter. */
  tile?: ImageMetadata;
  /** The album's prints under the hero. */
  prints?: Print[];
  /** The cards on Moments. */
  moments?: Moment[];
  /**
   * Missions on the camera: the "Missions 1/3" capsule under the counter, and
   * with `armed` the "Next photo: …" note at the viewfinder's top edge.
   */
  mission?: { done: number; total: number; armed?: string };
  /** The guest's missions in the sheet (`screen="missions"`). */
  missionList?: MissionItem[];
  /** The album viewer: who took it, which print of how many, and the mission it was for. */
  viewer?: { by: string; index: number; count: number; mission?: string };
  class?: string;
};

type MissionItem = { body: string; state: 'done' | 'armed' | 'open'; personal?: boolean };

type Print = { src: ImageMetadata; by: string };
type Moment = {
  title: string;
  photos: number;
  people: number;
  status: string;
  live: boolean;
  /** Photos beyond the strip: the last tile is blurred and reads "+N". */
  more: number;
  /** `null` is an empty frame. */
  strip: (ImageMetadata | null)[];
};

const {
  screen,
  label,
  photo = weddingDance,
  title = 'Mia & Jonas',
  shotsLeft = 17,
  eager = false,
  detail = 1,
  device: handset = 'iphone',
  tile = friendsLaugh,
  mission,
  viewer = { by: 'Lena', index: 24, count: 412, mission: 'A toast, just as glasses meet' },
  class: className,
} = Astro.props;

const missionList: MissionItem[] = Astro.props.missionList ?? [
  { body: 'A toast, just as glasses meet', state: 'armed' },
  { body: 'Catch someone mid-laugh', state: 'done' },
  { body: 'A photo with the couple’s oldest friend', state: 'open', personal: true },
];

/**
 * 09's QR code, real and scannable: it opens the website (an invite code
 * would lead to a film that does not exist). Drawn as one SVG path.
 */
const qr = QRCode.create(SITE.url, { errorCorrectionLevel: 'M' }).modules;
let qrPath = '';
for (let row = 0; row < qr.size; row++) {
  for (let col = 0; col < qr.size; col++) {
    if (qr.get(row, col)) qrPath += `M${col} ${row}h1v1h-1z`;
  }
}

const loading = eager ? 'eager' : 'lazy';
/** A picture's pixel size and JPEG quality at this `detail`. */
const px = (points: number) => Math.round(points * detail);
const q = (quality: number) => (detail > 1 ? Math.min(90, quality + 24) : quality);
/** Where the display sits in the frame, from the device's config. */
const pct = (fraction: number) => `${(fraction * 100).toFixed(4)}%`;
const android = handset === 'android';
/** The drawn Android handset: a 20:9 display, 32 units of bezel all round. */
const DROID = {
  framePngWidth: 1000,
  framePngHeight: 2144,
  screenLeftFraction: 0.032,
  screenTopFraction: 32 / 2144,
  screenWidthFraction: 0.936,
  screenHeightFraction: 2080 / 2144,
  screenRadiusFraction: 0.086,
};
const body = android ? DROID : device;
const screenWidth = body.framePngWidth * body.screenWidthFraction;
const screenHeight = body.framePngHeight * body.screenHeightFraction;
const radius = body.framePngWidth * body.screenRadiusFraction;
const geometry = [
  `--frame:${body.framePngWidth} / ${body.framePngHeight}`,
  `--sx:${pct(body.screenLeftFraction)}`,
  `--sy:${pct(body.screenTopFraction)}`,
  `--sw:${pct(body.screenWidthFraction)}`,
  `--sh:${pct(body.screenHeightFraction)}`,
  `--sr:${pct(radius / screenWidth)} / ${pct(radius / screenHeight)}`,
].join(';');

/** The album's prints under the hero, two to a row, each with who took it. */
const prints: Print[] = Astro.props.prints ?? [
  { src: weddingToast, by: 'Lena' },
  { src: sample3, by: 'Tom' },
  { src: dinnerCandle, by: 'Aylin' },
  { src: weddingChampagne, by: 'Marc' },
];

/** Your Moments: the last tile of a strip stands for the rest of the album. */
const moments: Moment[] = Astro.props.moments ?? [
  {
    title,
    photos: 412,
    people: 38,
    status: 'Developed',
    live: false,
    more: 409,
    strip: [weddingCrowd, weddingMono, weddingNight, partyFloor],
  },
  {
    title: 'Lena’s 30th',
    photos: 57,
    people: 14,
    status: '1d 4h left',
    live: true,
    more: 0,
    // Not developed yet: only your own frames.
    strip: [birthdayCandle, partyConfetti, partyToast, partyWine],
  },
  {
    title: 'Lisbon',
    photos: 96,
    people: 7,
    status: 'Developed',
    live: false,
    more: 93,
    strip: [tripSunset, tripCar, tripFriends, tripSurf],
  },
  {
    title: 'Housewarming',
    photos: 128,
    people: 21,
    status: 'Developed',
    live: false,
    more: 125,
    strip: [dinnerTable, partyDance, sample2, tripVan],
  },
];

/** Feather icons (24 grid, stroked), the set the app uses. */
const ICON = {
  x: 'M18 6L6 18M6 6l12 12',
  zap: 'M13 2L3 14h9l-1 8 10-12h-9l1-8z',
  flip: 'M23 4v6h-6M1 20v-6h6M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15',
  back: 'M15 18l-6-6 6-6',
  next: 'M9 18l6-6-6-6',
  plus: 'M12 5v14M5 12h14',
  users:
    'M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2M9 11a4 4 0 100-8 4 4 0 000 8zM23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75',
  settings:
    'M12 15a3 3 0 100-6 3 3 0 000 6zM19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-2 2 2 2 0 01-2-2v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83 0 2 2 0 010-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 01-2-2 2 2 0 012-2h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 010-2.83 2 2 0 012.83 0l.06.06a1.65 1.65 0 001.82.33H9a1.65 1.65 0 001-1.51V3a2 2 0 012-2 2 2 0 012 2v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 0 2 2 0 010 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1H21a2 2 0 012 2 2 2 0 01-2 2h-.09a1.65 1.65 0 00-1.51 1z',
  image:
    'M5 3h14a2 2 0 012 2v14a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2zM8.5 10a1.5 1.5 0 100-3 1.5 1.5 0 000 3zM21 15l-5-5L5 21',
  download: 'M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3',
  camera:
    'M23 19a2 2 0 01-2 2H3a2 2 0 01-2-2V8a2 2 0 012-2h4l2-3h6l2 3h4a2 2 0 012 2zM12 17a4 4 0 100-8 4 4 0 000 8z',
  arrow: 'M5 12h14M12 5l7 7-7 7',
  qr: 'M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h3v3h-3zM18 18h3v3h-3zM18 14h3M14 18v3',
  target: 'M12 22a10 10 0 100-20 10 10 0 000 20zM12 18a6 6 0 100-12 6 6 0 000 12zM12 14a2 2 0 100-4 2 2 0 000 4z',
  check: 'M20 6L9 17l-5-5',
  link: 'M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71',
  share: 'M4 12v8a2 2 0 002 2h12a2 2 0 002-2v-8M16 6l-4-4-4 4M12 2v13',
  flag: 'M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1zM4 22v-7',
};
---

<figure class:list={['phone', { android }, className]} role="img" aria-label={label} style={geometry}>
  <div class="screen" aria-hidden="true">
    <div class="canvas">
      {
        (screen === 'camera' || screen === 'missions') && (
          <div class="s camera">
            {/* The viewfinder is the screen, down to the shutter bar; the chrome floats on it. */}
            <div class="finder">
              <Image
                src={photo}
                alt=""
                width={px(720)}
                height={px(1260)}
                fit="cover"
                quality={q(64)}
                loading={loading}
                fetchpriority={eager ? 'high' : 'auto'}
                class="look-golden"
              />
              <span class="flash" />
              <span class="scrim-top" />
              <span class="scrim-bottom" />
              <div class="cam-head">
                <span class="round lg glass">
                  <svg viewBox="0 0 24 24"><path d={ICON.x} /></svg>
                </span>
                <span class="cam-title">
                  <span class="eyebrow-s">{title}</span>
                  <span class="roll">
                    <b data-count={screen === 'camera' ? shotsLeft : undefined}>{shotsLeft}</b>
                    <small>Left</small>
                  </span>
                  {mission && (
                    <span class="m-cap glass">
                      <svg viewBox="0 0 24 24"><path d={ICON.target} /></svg>
                      Missions {mission.done}/{mission.total}
                    </span>
                  )}
                </span>
                <span class="until">
                  <b>01</b><small>D</small><b class="dim">04</b><small>H</small>
                  <svg viewBox="0 0 24 24"><path d={ICON.next} /></svg>
                </span>
              </div>
              {mission?.armed && (
                <span class="armed">
                  <svg viewBox="0 0 24 24"><path d={ICON.target} /></svg>
                  <span>Next photo: {mission.armed}</span>
                  <svg viewBox="0 0 24 24" class="dim"><path d={ICON.x} /></svg>
                </span>
              )}
              <div class="cam-controls">
                <span class="round lg glass">
                  <svg viewBox="0 0 24 24"><path d={ICON.zap} /></svg>
                </span>
                <span class="zoom glass">
                  <i>0.5×</i><i class="on">1×</i><i>4×</i>
                </span>
                <span class="round lg glass">
                  <svg viewBox="0 0 24 24"><path d={ICON.flip} /></svg>
                </span>
              </div>
            </div>
            <div class="shutter-bar">
              <span class="tile glass">
                <Image src={tile} alt="" width={px(140)} height={px(140)} fit="cover" quality={q(55)} loading={loading} class="look-golden" />
              </span>
              <span class="shutter"><i /></span>
              <span class="tile glass">
                <svg viewBox="0 0 24 24"><path d={ICON.qr} /></svg>
              </span>
            </div>
            {screen === 'missions' && (
              <>
                <span class="sheet-dim" />
                <div class="m-sheet">
                  <span class="grabber" />
                  <p class="headline xs">
                    Your <em>missions.</em>
                  </p>
                  <p class="m-sub">Pick one, then take the photo.</p>
                  <div class="m-rows">
                    {missionList.map((item, index) => (
                      <span class:list={['m-row', `is-${item.state}`]} style={`--n:${index}`}>
                        <span class="m-text">
                          {item.personal && <small>Just for you</small>}
                          <b>{item.body}</b>
                        </span>
                        {item.state === 'done' ? (
                          <span class="m-trail ok">
                            <svg viewBox="0 0 24 24"><path d={ICON.check} /></svg>Done
                          </span>
                        ) : item.state === 'armed' ? (
                          <span class="m-trail">
                            <svg viewBox="0 0 24 24"><path d={ICON.target} /></svg>Next photo
                          </span>
                        ) : (
                          <span class="m-trail dim">
                            <svg viewBox="0 0 24 24"><path d={ICON.camera} /></svg>
                          </span>
                        )}
                      </span>
                    ))}
                  </div>
                </div>
              </>
            )}
          </div>
        )
      }

      {
        screen === 'looks' && (
          <div class="s looks">
            <div class="head">
              <span class="round flat">
                <svg viewBox="0 0 24 24"><path d={ICON.back} /></svg>
              </span>
              <span class="steps">
                <i class="done" /><i class="on" /><i /><i />
              </span>
              <span class="round" />
            </div>
            <span class="eyebrow-s wide">Film</span>
            <p class="headline">
              Which film are<br /><em>you loading?</em>
            </p>
            <div class="cards">
              {LOOKS.map((look, index) => (
                <div class:list={['card', { on: index === 0 }]} style={`--n:${index}`}>
                  <Image src={photo} alt="" width={px(340)} height={px(425)} fit="cover" quality={q(58)} loading={loading} class={`look-${look.id}`} />
                  <span class="card-text">
                    <b>{look.name}</b>
                    <small>{look.blurb}</small>
                  </span>
                </div>
              ))}
            </div>
            <span class="cta">
              <svg viewBox="0 0 24 24"><path d={ICON.arrow} /></svg>
              Continue
            </span>
          </div>
        )
      }

      {
        screen === 'moments' && (
          <div class="s moments">
            <div class="lib-head">
              <p class="headline sm">Moments</p>
              <span class="round lg glass">
                <svg viewBox="0 0 24 24"><path d={ICON.settings} /></svg>
              </span>
              <span class="round lg glass">
                <svg viewBox="0 0 24 24"><path d={ICON.users} /></svg>
              </span>
              <span class="round lg light">
                <svg viewBox="0 0 24 24"><path d={ICON.plus} /></svg>
              </span>
            </div>
            <div class="moment-list">
              {moments.map((moment, index) => (
                <div class="moment" style={`--n:${index}`}>
                  <div class="moment-head">
                    <span class="moment-name">
                      <b>{moment.title}</b>
                      <span class="moment-meta">
                        <span>
                          <svg viewBox="0 0 24 24"><path d={ICON.image} /></svg>
                          {moment.photos} photos
                        </span>
                        <span>
                          <svg viewBox="0 0 24 24"><path d={ICON.users} /></svg>
                          {moment.people} people
                        </span>
                      </span>
                    </span>
                    <span class="status-cap">
                      {moment.live && <i class="live-dot" />}
                      {moment.status}
                      {moment.live && <svg viewBox="0 0 24 24"><path d={ICON.next} /></svg>}
                    </span>
                  </div>
                  <div class="strip">
                    {moment.strip.map((image, tile) => {
                      const counted = moment.more > 0 && tile === moment.strip.length - 1;
                      return image ? (
                        <span class:list={{ counted }}>
                          {/* 24px wide and stretched: the upscale is the blur. */}
                          <Image
                            src={image}
                            alt=""
                            width={counted ? 24 : px(170)}
                            height={counted ? 32 : px(227)}
                            fit="cover"
                            quality={q(52)}
                            loading={loading}
                            class="look-golden"
                          />
                          {counted && <em>+{moment.more}</em>}
                        </span>
                      ) : (
                        <span class="blank" />
                      );
                    })}
                  </div>
                </div>
              ))}
            </div>
          </div>
        )
      }

      {
        screen === 'album' && (
          <div class="s album">
            <div class="hero-print">
              <Image src={photo} alt="" width={px(720)} height={px(1040)} fit="cover" quality={q(64)} loading={loading} class="look-golden" />
              <span class="veil" style="--n:0" />
              <span class="shade" />
              <div class="hero-text">
                <p class="headline xl">{title}</p>
                <p class="stats">
                  <span><b>412</b><small>Photos</small></span>
                  <i />
                  <span><b>38</b><small>People</small></span>
                </p>
                <span class="cta">
                  <svg viewBox="0 0 24 24"><path d={ICON.download} /></svg>
                  Save all
                </span>
              </div>
            </div>
            <div class="grid">
              {prints.map((print, index) => (
                <span>
                  <Image src={print.src} alt="" width={px(370)} height={px(494)} fit="cover" quality={q(56)} loading={loading} class="look-golden" />
                  <em>{print.by}</em>
                  <span class="veil" style={`--n:${index + 1}`} />
                </span>
              ))}
            </div>
            <div class="float">
              <span class="round lg glass">
                <svg viewBox="0 0 24 24"><path d={ICON.back} /></svg>
              </span>
            </div>
          </div>
        )
      }

      {
        screen === 'invite' && (
          <div class="s invite">
            <div class="head">
              <span class="round" />
              <span class="round flat">
                <svg viewBox="0 0 24 24"><path d={ICON.x} /></svg>
              </span>
            </div>
            <span class="eyebrow-s wide">{title}</span>
            <p class="headline">
              Invite your group.<br /><em>Let them in.</em>
            </p>
            <p class="meta">
              Show them the QR or send the link —<br />once they’re in, the cameras can open.
            </p>
            <div class="qr-zone">
              <span class="qr-card">
                <svg viewBox={`0 0 ${qr.size} ${qr.size}`} shape-rendering="crispEdges">
                  <path d={qrPath} />
                </svg>
              </span>
              <span class="share-row">
                <span class="share">
                  <svg viewBox="0 0 24 24"><path d={ICON.link} /></svg>Share Link
                </span>
                <span class="share">
                  <svg viewBox="0 0 24 24"><path d={ICON.download} /></svg>Save QR
                </span>
              </span>
            </div>
            <span class="cta">
              See who’s joined
              <svg viewBox="0 0 24 24"><path d={ICON.arrow} /></svg>
            </span>
          </div>
        )
      }

      {
        screen === 'viewer' && (
          <div class="s viewer">
            <Image src={photo} alt="" width={px(720)} height={px(1560)} fit="cover" quality={q(64)} loading={loading} class="look-golden" />
            <span class="v-shade" />
            <div class="v-top">
              <span class="round lg glass">
                <svg viewBox="0 0 24 24"><path d={ICON.x} /></svg>
              </span>
              <span class="v-count glass">
                <b>{viewer.index} / {viewer.count}</b>
                <small>{viewer.by}</small>
              </span>
              <span class="round lg" />
            </div>
            <div class="v-bottom">
              {viewer.mission && (
                <span class="v-mission glass">
                  <svg viewBox="0 0 24 24"><path d={ICON.target} /></svg>
                  <span><i>Mission · </i>{viewer.mission}</span>
                </span>
              )}
              <span class="v-actions">
                <span class="round lg glass">
                  <svg viewBox="0 0 24 24"><path d={ICON.download} /></svg>
                </span>
                <span class="round lg glass">
                  <svg viewBox="0 0 24 24"><path d={ICON.share} /></svg>
                </span>
                <span class="round lg glass">
                  <svg viewBox="0 0 24 24"><path d={ICON.flag} /></svg>
                </span>
              </span>
            </div>
          </div>
        )
      }

      {
        screen === 'developing' && (
          <div class="s developing">
            <div class="float">
              <span class="round lg glass">
                <svg viewBox="0 0 24 24"><path d={ICON.back} /></svg>
              </span>
            </div>
            <div class="dev-body">
              <span class="eyebrow-s wide">{title}</span>
              <p class="headline">
                Nothing to see<br /><em>yet.</em>
              </p>
              <p class="clock">
                <b>04</b><small>h</small><b>12</b><small>m</small><b data-tick>48</b><small>s</small>
              </p>
              <p class="meta">
                412 photos so far, from 38 people.<br />They appear together when the film is developed.
              </p>
              <div class="frames">
                {[0, 1, 2, 3, 4].map((index) => (
                  <i style={`--n:${index}`} />
                ))}
              </div>
            </div>
