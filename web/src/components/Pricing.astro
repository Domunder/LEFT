---
/**
 * Pricing, as little as it takes (2026-11-23, the user: "just the price and
 * how many guests"): per tier the group size and the price, nothing else (a
 * row of dots per ten guests was tried and removed the same day). What every
 * event has, and what a paid one adds, is said once under the cards.
 * Past the largest tier: an email (`SITE.eventsEmail`).
 */
import { SITE, TIERS } from '../site';

type Props = { highlight?: string };
const { highlight } = Astro.props;

const PER_DOT = 10;
const largest = TIERS[TIERS.length - 1].guests;
const mail = `mailto:${SITE.eventsEmail}?subject=${encodeURIComponent(`An event with more than ${largest} guests`)}`;
---

<section id="pricing" class="pricing">
  <div class="wrap">
    <div class="section-head center reveal">
      <p class="eyebrow">Pricing</p>
      <h2>Free for most parties. <em>A few dollars for the big ones.</em></h2>
      <p class="lede">The host pays once per event. Guests never pay.</p>
    </div>
    <ul class="tiers reveal">
      {
        TIERS.map((tier) => (
          <li class:list={[{ on: tier.id === highlight }]}>
            <p class="guests">
              <small>Up to</small>
              <b>{tier.guests}</b>
              <small>guests</small>
            </p>
            <p class="price">{tier.price === 0 ? 'Free' : `$${tier.price}`}</p>
          </li>
        ))
      }
    </ul>
    <p class="more reveal">
      <span>More than {largest} guests?</span>
      <a href={mail}>Write to {SITE.eventsEmail}</a>
    </p>
    <p class="fine reveal">
      One-time, per event. No subscription. Every event has all four film looks and missions; a free one has
      rolls of 5 to 36 photos, a paid one can be unlimited (up to 150 photos per guest). Prices are charged in
      the app and may vary slightly by store and country.
    </p>
  </div>
</section>

<style>
  .tiers {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 12px;
  }

  .tiers > li {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 24px;
    padding: 24px 24px 26px;
    display: grid;
    gap: 6px;
    align-content: start;
  }

  .tiers > li.on {
    border-color: var(--ink-30);
    background: linear-gradient(180deg, rgba(240, 190, 140, 0.1), transparent 70%), var(--card);
  }

  .guests {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0 8px;
  }

  .guests b {
    font-family: var(--numeral);
    font-weight: 400;
    font-size: 3.4rem;
    line-height: 1;
  }

  .guests small {
    font-family: var(--serif);
    font-size: 1.35rem;
    color: var(--ink-70);
  }

  .price {
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--amber);
    font-variant-numeric: tabular-nums;
  }

  .more {
    margin-top: 12px;
    padding: 18px 24px;
    border: 1px solid var(--line);
    border-radius: 24px;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 6px 24px;
  }

  .more span {
    font-family: var(--serif);
    font-size: 1.35rem;
  }

  .more a {
    color: var(--amber);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: var(--ink-30);
  }

  .more a:hover {
    text-decoration-color: currentColor;
  }

  .fine {
    margin-top: 28px;
    text-align: center;
    color: var(--ink-55);
    font-size: 0.875rem;
  }
</style>
