---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found — LEFT" description="This page does not exist." noindex>
  <section style="padding-top: clamp(150px, 20vw, 220px); min-height: 70svh">
    <div class="wrap" style="display: grid; gap: 22px; justify-items: start">
      <p class="eyebrow">404</p>
      <h1>Nothing <em>developed here.</em></h1>
      <p class="lede">The page you were looking for doesn’t exist, or the link is out of date.</p>
      <a class="pill pill-primary" href="/">Back to LEFT</a>
    </div>
  </section>
</Base>
