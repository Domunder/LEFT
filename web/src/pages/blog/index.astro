---
/** The blog's front page: every article, newest first. */
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import GetApp from '../../components/GetApp.astro';
import { SITE } from '../../site';
import { allPosts, formatDate, photoFor } from '../../blog';

const posts = await allPosts();

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: 'LEFT Blog',
    url: `${SITE.url}/blog/`,
    blogPost: posts.map((post) => ({
      '@type': 'BlogPosting',
      headline: post.data.title,
      url: `${SITE.url}/blog/${post.id}/`,
      datePublished: post.data.date.toISOString(),
    })),
  },
];
---

<Base
  title="Blog: ideas for wedding, party and trip photos | LEFT"
  description="Ideas and how-tos for the photos of your wedding, party or group trip: guest photos, disposable cameras, photo challenges and the album afterwards."
  jsonLd={jsonLd}
>
  <section class="head">
    <div class="glow" aria-hidden="true"></div>
    <div class="wrap section-head">
      <p class="eyebrow">Blog</p>
      <h1>Ideas for the photos <em>everyone takes.</em></h1>
      <p class="lede">Weddings, parties and trips, seen through your guests’ cameras.</p>
    </div>
  </section>

  <section class="posts">
    <div class="wrap">
      {posts.length === 0 && <p class="lede">The first articles are on their way.</p>}
      <ul class="grid">
        {
          posts.map((post, index) => (
            <li>
              <a class="card" href={`/blog/${post.id}/`}>
                <Picture
                  src={photoFor(post)}
                  alt=""
                  formats={['avif', 'webp']}
                  widths={[400, 640, 960]}
                  sizes="(max-width: 700px) calc(100vw - 40px), (max-width: 1000px) 50vw, 373px"
                  loading={index < 3 ? 'eager' : 'lazy'}
                  class={`look-${post.data.look}`}
                />
                <div class="text">
                  <p class="eyebrow">{post.data.cluster}</p>
                  <h2>{post.data.title}</h2>
                  <p class="summary">{post.data.description}</p>
                  <p class="date">
                    <time datetime={post.data.date.toISOString().slice(0, 10)}>{formatDate(post.data.date)}</time>
                  </p>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <GetApp />
</Base>

<style>
  .head {
    padding-top: clamp(140px, 17vw, 200px);
    padding-bottom: 0;
  }

  .head .glow {
    right: -25%;
    top: -60%;
  }

  .head .section-head {
    margin-bottom: 0;
  }

  .posts {
    padding-top: clamp(40px, 6vw, 72px);
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 14px;
  }

  .card {
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100%;
    text-decoration: none;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 24px;
    overflow: hidden;
    transition:
      border-color 0.25s var(--ease),
      transform 0.25s var(--ease);
  }

  .card:hover {
    border-color: var(--ink-30);
  }

  .card:active {
    transform: scale(0.985);
  }

  .card :global(img) {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .text {
    display: grid;
    gap: 10px;
    align-content: start;
    padding: 22px 24px 24px;
  }

  .text h2 {
    font-size: 1.5rem;
    line-height: 1.18;
  }

  .summary {
    color: var(--ink-70);
    font-size: 0.95rem;
  }

  .date {
    color: var(--ink-55);
    font-size: 0.8rem;
  }
</style>
