---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Phone from '../components/Phone.astro';
import StoreButtons from '../components/StoreButtons.astro';
import Pricing from '../components/Pricing.astro';
import Faq from '../components/Faq.astro';
import GetApp from '../components/GetApp.astro';
import { HOME_FAQ, LOOKS, SITE, TIERS } from '../site';

import weddingDance from '../assets/photos/wedding-dance.jpg';
import weddingCrowd from '../assets/photos/wedding-crowd.jpg';
import weddingFriends from '../assets/photos/wedding-friends.jpg';
import weddingMono from '../assets/photos/wedding-mono.jpg';
import partyFlash from '../assets/photos/party-flash.jpg';
import partyWine from '../assets/photos/party-wine.jpg';
import birthdayCandle from '../assets/photos/birthday-candle.jpg';
import dinnerCandle from '../assets/photos/dinner-candle.jpg';
import tripTrunk from '../assets/photos/trip-trunk.jpg';
import tripVan from '../assets/photos/trip-van.jpg';

const title = 'LEFT — The disposable camera app for weddings, parties and trips';
const description =
  'Guests join by link or QR code and get a limited roll of photos. Nothing is visible until the event ends — then the whole group’s film is developed together.';

// Two rows that slide against each other as the page scrolls. `ratio` is the
// frame's width over its height; the row height is shared.
const reel = [
  [
    { src: partyFlash, ratio: 1.5, alt: 'A group of friends squeezed together at a party, lit by a camera flash' },
    { src: weddingFriends, ratio: 0.8, alt: 'A bride raising her bouquet while dancing with friends' },
    { src: dinnerCandle, ratio: 1.5, alt: 'Friends sharing a long dinner by candlelight' },
    { src: weddingCrowd, ratio: 1, alt: 'Wedding guests waving sparklers around the couple at night' },
    { src: partyWine, ratio: 0.8, alt: 'Friends pouring wine and laughing at a house party' },
  ],
  [
    { src: birthdayCandle, ratio: 0.8, alt: 'People gathered around a table with a single lit candle' },
    { src: tripTrunk, ratio: 1.5, alt: 'Two friends sitting in the open boot of a small car on a road trip' },
    { src: weddingDance, ratio: 1, alt: 'A couple on a wedding dance floor' },
    { src: weddingMono, ratio: 1.5, alt: 'Wedding guests caught mid-celebration' },
    { src: tripVan, ratio: 0.8, alt: 'A white camper van on a country road at sunset' },
  ],
];

const steps = [
  {
    screen: 'join',
    photo: weddingCrowd,
    label: 'LEFT name screen: a guest types their name to join, no account needed',
    title: 'Join with a link',
    text: 'Share a link or put the QR code on the tables. Guests type a name and they’re in. No sign-up, no password.',
  },
  {
    screen: 'camera',
    photo: weddingDance,
    label: 'LEFT camera screen showing a wedding dance floor and a counter that reads 17 left',
    title: 'Shoot your roll',
    text: 'Everyone gets the same short roll — 5 to 36 photos. When you only have a few left, you start to choose.',
  },
  {
    screen: 'developing',
    photo: weddingDance,
    label: 'LEFT developing screen: nothing to see yet, with a countdown until the film is developed',
    title: 'Developed together',
    text: 'Nobody sees the album until the event ends. Then the film is developed and every photo appears for everyone at once.',
  },
] as const;

const cases = [
  { href: '/use-cases/#parties', src: partyFlash, title: 'Parties', alt: 'Friends posing close together at a party' },
  { href: '/use-cases/#trips', src: tripVan, title: 'Trips', alt: 'A white camper van on a country road at sunset' },
  { href: '/use-cases/#birthdays', src: birthdayCandle, title: 'Birthdays', alt: 'A birthday table lit by one candle' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.url,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'LEFT',
    description,
    url: SITE.url,
    applicationCategory: 'PhotographyApplication',
    operatingSystem: 'iOS, Android',
    offers: {
      '@type': 'AggregateOffer',
      priceCurrency: 'USD',
      lowPrice: 0,
      highPrice: TIERS[TIERS.length - 1].price,
      offerCount: TIERS.length,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: HOME_FAQ.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
];
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <section class="hero">
    <div class="glow" aria-hidden="true" data-parallax="0.18"></div>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow enter">A disposable camera for events</p>
        <h1>
          <span class="line"><span style="--i:1">One roll each.</span></span>
          <span class="line"><span style="--i:2"><em>Developed together.</em></span></span>
        </h1>
        <p class="lede enter" style="--i:4">
          LEFT turns every guest’s phone into a disposable camera. A few shots each, one film look, and nothing
          to see until the party is over — then the whole group’s photos appear at once.
        </p>
        <div class="enter" style="--i:5"><StoreButtons /></div>
        <p class="hint enter" style="--i:6">Free for up to 50 guests. No account for guests.</p>
      </div>
      <div class="hero-visual">
        <div class="hero-back" data-parallax="-0.08">
          <Phone
            screen="album"
            class="arrive-back"
            label="The developed album on a second phone: a grid of the photos every guest took"
          />
        </div>
        <div class="hero-front" data-parallax="0.04">
          <Phone
            screen="camera"
            eager
            class="arrive-front"
            label="The LEFT camera on a phone: a wedding dance floor in the viewfinder and a counter that reads 17 left"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="reel-section" aria-label="Photos from parties, weddings and trips">
    <div class="reel" data-reel>
      {
        reel.map((row, index) => (
          <ul data-dir={index === 1 ? 'back' : undefined}>
            {row.map((photo) => (
              <li class="develop" style={`--r:${photo.ratio}`}>
                <Picture
                  src={photo.src}
                  alt={photo.alt}
                  formats={['avif', 'webp']}
                  widths={[Math.round(300 * photo.ratio), Math.round(600 * photo.ratio)]}
                  sizes={`${Math.round(300 * photo.ratio)}px`}
                  width={Math.round(600 * photo.ratio)}
                  height={600}
                  fit="cover"
                  class="look-golden"
                />
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </section>

  <section id="how" class="how">
    <div class="wrap">
      <div class="section-head center reveal">
        <p class="eyebrow">How it works</p>
        <h2>Three steps. <em>No instructions needed.</em></h2>
      </div>
      <ol class="steps">
        {
          steps.map((step, index) => (
            <li class="reveal" data-reveal="scale">
              <Phone screen={step.screen} photo={step.photo} label={step.label} />
              <p class="num" aria-hidden="true">
                {index + 1}
              </p>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="looks" class="looks">
    <div class="wrap looks-grid">
      <div class="looks-copy reveal" data-reveal="left">
        <p class="eyebrow">The film</p>
        <h2>One look <em>for the whole night.</em></h2>
        <p class="lede">
          The host loads one film for the event. You see it in the viewfinder while you shoot, and it’s in every
          photo — so two hundred phones make one album that belongs together.
        </p>
        <ul class="look-list">
          {
            LOOKS.map((look) => (
              <li>
                <Picture
                  src={weddingFriends}
                  alt={`The same wedding photo in the ${look.name} look`}
                  formats={['avif', 'webp']}
                  widths={[280, 560]}
                  sizes="(min-width: 900px) 250px, 44vw"
                  width={560}
                  height={700}
                  fit="cover"
                  class={`look-${look.id}`}
                />
                <h3>{look.name}</h3>
                <p>{look.blurb}</p>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="looks-phone reveal" data-reveal="right">
        <Phone
          screen="looks"
          photo={weddingFriends}
          label="LEFT film picker with four looks: Golden, Chrome, Faded and Mono"
        />
      </div>
    </div>
  </section>

  <section class="album">
    <div class="glow" aria-hidden="true" data-parallax="0.18"></div>
    <div class="wrap album-grid">
      <div class="album-phones reveal" data-reveal="scale">
        <Phone
          screen="moments"
          class="tilt-left"
          label="LEFT Your Moments screen: a stack of prints from Mia and Jonas’s wedding, developed, 412 photos"
        />
        <Phone
          screen="album"
          class="tilt-right"
          label="LEFT album screen: a grid of 412 photos taken by 38 guests"
        />
      </div>
      <div class="album-copy reveal" data-reveal="right">
        <p class="eyebrow">The reveal</p>
        <h2>The morning after, <em>the whole night comes back.</em></h2>
        <p class="lede">
          The dance floor you missed. The table you never sat at. What your grandmother thought was worth one of
          her twelve shots. Every guest’s roll lands in one shared album — to keep, save and send around.
        </p>
        <ul class="points">
          <li>Everyone who joined gets the full album</li>
          <li>Save photos to your phone and share them</li>
          <li>The host can remove any photo, guests their own</li>
        </ul>
      </div>
    </div>
  </section>

  <section id="use-cases" class="cases">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Use cases</p>
        <h2>Made for days <em>you don’t get twice.</em></h2>
      </div>
      <div class="case-grid reveal">
        <a class="case big" href="/wedding/">
          <Picture
            src={weddingCrowd}
            alt="Wedding guests waving sparklers around the newlyweds at night"
            formats={['avif', 'webp']}
            widths={[640, 960, 1440, 1920]}
            sizes="(min-width: 900px) 780px, 100vw"
            quality={72}
            class="look-golden"
          />
          <span>
            <b>Weddings</b>
            <small>Your day through every guest’s eyes →</small>
          </span>
        </a>
        {
          cases.map((item) => (
            <a class="case" href={item.href}>
              <Picture
                src={item.src}
                alt={item.alt}
                formats={['avif', 'webp']}
                widths={[480, 800, 1280]}
                sizes="(min-width: 900px) 400px, 100vw"
                width={1280}
                height={960}
                quality={72}
                fit="cover"
                class="look-golden"
              />
              <span>
                <b>{item.title}</b>
              </span>
            </a>
          ))
        }
      </div>
      <p class="more reveal">
        <a class="text-link" href="/use-cases/">See all use cases →</a>
      </p>
    </div>
  </section>

  <Pricing highlight="free" />
  <Faq items={HOME_FAQ} />
  <GetApp />
</Base>

<style>
  /* Hero */
  .hero {
    padding-top: clamp(120px, 16vw, 176px);
    padding-bottom: clamp(48px, 8vw, 96px);
    overflow: hidden;
  }

  .hero .glow {
    right: -18%;
    top: -6%;
  }

  .hero-grid {
    display: grid;
    gap: 56px;
    align-items: center;
  }

  .hero-copy {
    display: grid;
    gap: 22px;
    justify-items: start;
  }

  .hint {
    color: var(--ink-55);
    font-size: 0.875rem;
  }

  /*
    Two phones on a wide screen: the camera in front, the album it becomes
    behind it. A phone-sized screen gets the camera alone — there is no room
    for the pair, and a second phone doubles what a handset has to draw before
    the page is usable.
  */
  .hero-visual {
    --w: min(290px, 68vw);
    position: relative;
    display: grid;
    justify-items: center;
    padding-block: 12px 28px;
  }

  .hero-front {
    position: relative;
    width: var(--w);
  }

  .hero-back {
    display: none;
    position: absolute;
    width: calc(var(--w) * 0.88);
    top: 9%;
    left: calc(50% + var(--w) * 0.02);
  }

  @media (min-width: 900px) {
    .hero-front {
      margin-right: calc(var(--w) * 0.34);
    }
    .hero-back {
      display: block;
    }
  }

  .hero-visual :global(.phone) {
    max-width: none;
  }

  .hero-visual :global(.arrive-front) {
    animation: arrive-front 1.5s var(--ease) 0.15s both;
  }

  .hero-visual :global(.arrive-back) {
    transform: rotate(7deg);
    animation: arrive-back 1.7s var(--ease) 0.3s both;
  }

  /* Transform only: the viewfinder photo is the page's largest paint. */
  @keyframes arrive-front {
    from {
      transform: translate3d(0, 70px, 0) rotate(-5deg) scale(0.94);
    }
  }

  @keyframes arrive-back {
    from {
      opacity: 0;
      transform: translate3d(-22%, 60px, 0) rotate(0deg) scale(0.92);
    }
  }

  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 40px;
    }
  }

  /* The photo band: two rows sliding against each other with the scroll. */
  .reel-section {
    padding-block: 16px 40px;
    overflow: hidden;
  }

  .reel {
    /* Five frames a row, about 5.6 heights wide: always wider than the page. */
    --h: max(150px, 22vw);
    display: grid;
    gap: clamp(8px, 1.2vw, 14px);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 9%, #000 91%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 9%, #000 91%, transparent);
  }

  .reel ul {
    display: flex;
    gap: clamp(8px, 1.2vw, 14px);
    width: max-content;
    list-style: none;
    margin: 0;
    padding: 0;
    will-change: transform;
  }

  .reel ul[data-dir='back'] {
    transform: translate3d(calc(100vw - 100%), 0, 0);
  }

  .reel li {
    position: relative;
    flex: none;
    height: var(--h);
    width: calc(var(--h) * var(--r));
    border-radius: clamp(12px, 1.6vw, 20px);
    overflow: hidden;
    background: var(--card);
  }

  .reel :global(picture),
  .reel :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* How it works */
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 64px;
  }

  .steps li {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 10px;
  }

  .steps :global(.phone) {
    max-width: 250px;
    margin-bottom: 22px;
  }

  .num {
    font-family: var(--numeral);
    font-size: 1.6rem;
    color: var(--amber);
    line-height: 1;
  }

  .steps li > p:last-child {
    color: var(--ink-70);
    max-width: 32ch;
  }

  @media (min-width: 820px) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
      gap: 32px;
    }
  }

  /* Looks */
  .looks-grid {
    display: grid;
    gap: 56px;
    align-items: center;
  }

  .looks-copy {
    display: grid;
    gap: 20px;
  }

  .look-list {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px 14px;
  }

  .look-list :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 18px;
    margin-bottom: 12px;
  }

  .look-list p {
    color: var(--ink-70);
    font-size: 0.9rem;
  }

  .looks-phone {
    display: grid;
    justify-items: center;
  }

  @media (min-width: 900px) {
    .looks-grid {
      grid-template-columns: 1.5fr 0.7fr;
    }
    .look-list {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* Album */
  .album {
    overflow: hidden;
  }

  .album .glow {
    left: -20%;
    top: 10%;
  }

  .album-grid {
    display: grid;
    gap: 56px;
    align-items: center;
  }

  .album-phones {
    display: flex;
    justify-content: center;
    gap: 0;
  }

  .album-phones :global(.phone) {
    max-width: min(240px, 44vw);
  }

  .album-phones :global(.tilt-left) {
    transform: rotate(-5deg) translateX(6%);
  }

  .album-phones :global(.tilt-right) {
    transform: rotate(4deg) translate(-6%, 8%);
  }

  .album-copy {
    display: grid;
    gap: 20px;
  }

  .points {
    list-style: none;
    margin: 6px 0 0;
    padding: 0;
    display: grid;
    gap: 12px;
    color: var(--ink-70);
  }

  .points li {
    padding-left: 26px;
    position: relative;
  }

  .points li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.62em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--amber);
  }

  @media (min-width: 900px) {
    .album-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Use cases */
  .case-grid {
    display: grid;
    gap: 14px;
  }

  .case {
    position: relative;
    display: block;
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    aspect-ratio: 4 / 3;
    background: var(--card);
  }

  .case :global(picture),
  .case :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease);
  }

  .case:hover :global(img) {
    transform: scale(1.04);
  }

  .case span {
    position: absolute;
    inset: auto 0 0 0;
    padding: 70px 24px 22px;
    background: linear-gradient(transparent, rgba(6, 6, 8, 0.88));
    display: grid;
    gap: 4px;
  }

  .case b {
    font-family: var(--serif);
    font-weight: 340;
    font-size: 1.7rem;
    line-height: 1.1;
  }

  .case.big :global(img) {
    object-position: 50% 78%;
  }

  .case.big b {
    font-size: clamp(2rem, 4vw, 2.8rem);
  }

  .case small {
    color: var(--ink-70);
    font-size: 0.95rem;
  }

  .more {
    margin-top: 32px;
  }

  @media (min-width: 900px) {
    .case-grid {
      grid-template-columns: 2fr 1fr;
      grid-template-rows: repeat(3, 1fr);
    }
    .case {
      aspect-ratio: auto;
      min-height: 190px;
    }
    .case.big {
      grid-row: 1 / span 3;
    }
  }
</style>
