---
/**
 * The invite landing: https://leftmoment.com/j/{CODE}.
 *
 * One static page serves every code (public/_redirects rewrites `/j/*` here);
 * the code is read from the path in the browser. Who ends up on it:
 *
 *  - has LEFT installed → never sees this page; the universal / app link opens
 *    the app directly (mobile/app.json + the files in public/.well-known).
 *    Exception: in-app browsers that swallow universal links — hence the
 *    "Open in LEFT" button, which uses the `left://` scheme.
 *  - no app, on a phone → forwarded to the store once `SITE.appStoreUrl` /
 *    `SITE.playStoreUrl` are set. Until then the page is shown.
 *  - anything else → the page, with the code and both store buttons.
 *
 * The code does not survive the store install, so the page tells the guest to
 * tap the link again afterwards.
 */
import Base from '../../layouts/Base.astro';
import StoreButtons from '../../components/StoreButtons.astro';
import { SITE } from '../../site';

const config = { ios: SITE.appStoreUrl, android: SITE.playStoreUrl, scheme: SITE.scheme };
---

<Base
  title="You’re invited — LEFT"
  description="Open this invite in LEFT, the disposable camera for events."
  noindex
  bare
>
  <section class="invite">
    <div class="glow" aria-hidden="true"></div>
    <div class="wrap card-wrap">
      <div class="card glass">
        <p class="eyebrow">You’re invited</p>
        <h1>Join the <em>film.</em></h1>
        <p class="lede" id="invite-lede">
          Someone wants you to shoot a roll at their event. Get LEFT, then tap your invite link again to join.
        </p>
        <p class="code" id="invite-code" hidden>
          <small>Invite code</small>
          <b></b>
        </p>
        <a class="pill pill-primary" id="invite-open" hidden>Open in LEFT</a>
        <StoreButtons />
        <p class="fine">No account needed. You only type your name.</p>
      </div>
      <p class="what">
        <a class="text-link" href="/">What is LEFT? →</a>
      </p>
    </div>
  </section>
</Base>

<script is:inline define:vars={{ config }}>
  (() => {
    const fromPath = location.pathname.match(/^\/j\/([^/?#]+)/i);
    const raw = (fromPath ? fromPath[1] : new URLSearchParams(location.search).get('c')) || '';
    const code = raw.toUpperCase();
    if (!/^[A-Z0-9]{4,12}$/.test(code)) return;

    const ua = navigator.userAgent;
    const store = /iPhone|iPad|iPod/i.test(ua) ? config.ios : /Android/i.test(ua) ? config.android : null;

    const box = document.getElementById('invite-code');
    box.querySelector('b').textContent = code;
    box.hidden = false;

    const open = document.getElementById('invite-open');
    open.href = config.scheme + '://j/' + code;
    open.hidden = false;

    document.title = 'Invite ' + code + ' — LEFT';

    // A phone without the app lands here; send it on to its store. `?stay`
    // keeps the page, for a guest coming back from the store.
    if (store && !new URLSearchParams(location.search).has('stay')) {
      location.replace(store);
    }
  })();
</script>

<style>
  .invite {
    min-height: 100svh;
    display: grid;
    align-items: center;
    padding-top: 110px;
    overflow: hidden;
  }

  .glow {
    left: 50%;
    top: 40%;
    transform: translate(-50%, -50%);
  }

  .card-wrap {
    display: grid;
    justify-items: center;
    gap: 28px;
  }

  .card {
    width: min(460px, 100%);
    padding: 36px clamp(22px, 5vw, 36px) 30px;
    border-radius: var(--radius);
    display: grid;
    gap: 18px;
  }

  h1 {
    font-size: clamp(2.4rem, 8vw, 3.2rem);
  }

  .code {
    display: grid;
    gap: 2px;
    padding: 14px 18px;
    border-radius: 16px;
    background: rgba(240, 237, 232, 0.07);
  }

  .code small {
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-55);
  }

  .code b {
    font-family: var(--numeral);
    font-weight: 400;
    font-size: 2rem;
    letter-spacing: 0.08em;
  }

  [hidden] {
    display: none !important;
  }

  .fine {
    color: var(--ink-55);
    font-size: 0.875rem;
  }
</style>
