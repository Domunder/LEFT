---
/**
 * The invite link and the web camera: https://leftmoment.com/j/{CODE}.
 *
 * One static page serves every code (public/_redirects rewrites `/j/*` here);
 * the code is read from the path in the browser. Who ends up on it:
 *
 *  - has LEFT installed → never sees this page; the universal / app link opens
 *    the app directly (mobile/app.json + the files in public/.well-known).
 *    On an iPhone without it, the App Clip's card shows over this page.
 *  - everyone else first sees **get the app** (2026-11-21, the user): the store
 *    buttons and, under them, "Continue in the browser", which leads to the
 *    web camera with a note that it is limited — a name, then the camera, with
 *    the same roll, look and reveal as the app, all enforced by the server
 *    (`src/shoot/api.ts`). After the reveal the same link is the album. A guest
 *    who already joined in this browser goes straight back in. Android sees
 *    it too ("Coming soon to Google Play" until the listing exists).
 *
 * Everything below is one screen at a time, switched by `data-view` on
 * `.shoot` from `src/shoot/app.ts`. Screens carry the states the app's do:
 * loading, error, waiting for the host, permission denied, roll empty,
 * developing, the album.
 */
import Base from '../../layouts/Base.astro';
import StoreButtons from '../../components/StoreButtons.astro';
import '../../styles/shoot.css';
---

<Base
  title="You’re invited — LEFT"
  description="Join the film: one roll of photos each, developed together when the event ends."
  noindex
  app
  appClip
>
  <div class="shoot" data-view="loading">
    <div class="glow shoot-glow" aria-hidden="true"></div>

    <!-- Loading -->
    <section class="screen screen-center" data-screen="loading" aria-busy="true">
      <p class="eyebrow">LEFT</p>
      <span class="spinner" aria-label="Loading"></span>
    </section>

    <!-- Get the app: the first thing a new guest sees (the app, or the clip's card, is the real experience) -->
    <section class="screen screen-center" data-screen="get-app">
      <div class="card glass join get-app">
        <p class="eyebrow">You’re invited</p>
        <h1>Join the <em>film.</em></h1>
        <p class="lede">
          One roll of photos each, developed together when the event ends. Get LEFT and open this link again.
        </p>
        <StoreButtons />
      </div>
      <button class="browser-link press" id="use-browser" type="button">Continue in the browser</button>
    </section>

    <!-- Join: the name, then straight into the event -->
    <section class="screen screen-center" data-screen="join">
      <form class="card glass join" id="join-form" novalidate>
        <p class="eyebrow">You’re invited</p>
        <h1>Join the <em>film.</em></h1>
        <p class="lede">
          One roll of photos each, developed together when the event ends.
        </p>
        <p class="browser-note" id="browser-note">
          <b>The browser version is limited.</b> No reminders when the film is developed, simpler
          photos, and it may stop when you leave this page.<span> For the full experience,{' '}
          <button class="inline-link" id="back-to-app" type="button">get the app</button>.</span>
        </p>
        <label class="field">
          <span class="visually-hidden">Your name</span>
          <input
            id="join-name"
            name="name"
            type="text"
            placeholder="Your name"
            autocomplete="name"
            autocapitalize="words"
            maxlength="60"
            enterkeyhint="go"
            required
          />
        </label>
        <p class="helper">This is how the group will see you during the event.</p>
        <!-- Missions: a name the host listed for personal missions. Drawn only when there are some. -->
        <fieldset class="names" id="join-names" hidden>
          <legend>Are you one of these?</legend>
          <div class="chips" id="join-name-chips"></div>
        </fieldset>
        <p class="error" id="join-error" role="alert"></p>
        <button class="pill pill-primary press" id="join-submit" type="submit" disabled>Start shooting</button>
        <p class="fine">
          No account needed. By joining you accept the <a href="/terms/">Terms</a>{' '}
          and the <a href="/privacy/">Privacy Policy</a>.
        </p>
      </form>
    </section>

    <!--
      How this moment works: once per moment and browser, between the name and
      the wait (the app's `(guest)/intro`). Swipe (scroll-snap) or Next; Skip.
    -->
    <section class="screen intro" data-screen="intro" aria-label="How this moment works">
      <header class="intro-head">
        <p class="eyebrow" data-bind="event-name"></p>
        <button class="intro-skip press" id="intro-skip" type="button" aria-label="Skip the introduction">Skip</button>
      </header>

      <div class="intro-pager" id="intro-pager">
        <article class="intro-page">
          <div class="intro-visual">
            <div class="mini-cam" role="img" id="intro-cam">
              <div class="mini-frame">
                <img id="intro-cam-img" alt="" />
                <span class="mini-count" id="intro-cam-count"></span>
              </div>
              <div class="mini-bar" aria-hidden="true">
                <span class="mini-tile"><img id="intro-cam-tile" alt="" /></span>
                <span class="mini-shutter"><span></span></span>
                <span class="mini-tile mini-icon">
                  <svg viewBox="0 0 24 24"><path d="M15 8a3 3 0 1 0-6 0 3 3 0 0 0 6 0zM4 20c.8-3.5 4-5.5 8-5.5M18 14v6M15 17h6" /></svg>
                </span>
              </div>
            </div>
          </div>
          <div class="intro-text">
            <p class="intro-numeral" id="intro-roll"></p>
            <h2 id="intro-roll-title"></h2>
            <p class="lede" id="intro-roll-text"></p>
          </div>
        </article>

        <article class="intro-page">
          <div class="intro-visual intro-prints" aria-hidden="true">
            <span class="intro-print side"><img id="intro-other-a" alt="" /></span>
            <span class="intro-print"><img id="intro-yours" alt="" /><span class="intro-tag">Yours</span></span>
            <span class="intro-print side"><img id="intro-other-b" alt="" /></span>
          </div>
          <div class="intro-text">
            <h2>Hidden until <em>the end.</em></h2>
            <p class="lede">You can look at your own photos. Everyone else’s stay dark until the film develops.</p>
          </div>
        </article>

        <article class="intro-page" id="intro-missions">
          <div class="intro-visual intro-missions" aria-hidden="true">
            <span class="intro-capsule" id="intro-capsule"></span>
            <p class="intro-note">
              <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><circle cx="12" cy="12" r="5" /><circle cx="12" cy="12" r="1" /></svg>
              <span>Next photo: A photo with someone you’ve never met</span>
            </p>
          </div>
          <div class="intro-text">
            <h2>Your <em>missions.</em></h2>
            <p class="lede" id="intro-missions-text"></p>
          </div>
        </article>

        <article class="intro-page">
          <div class="intro-visual">
            <p class="intro-date" id="intro-date"></p>
            <p class="intro-numeral" id="intro-time"></p>
          </div>
          <div class="intro-text">
            <h2>Developed <em>together.</em></h2>
            <p class="lede">Then the cameras close and everyone sees every photo at once, right here on this link.</p>
          </div>
        </article>
      </div>

      <footer class="intro-foot">
        <div class="intro-dots" id="intro-dots" aria-hidden="true"></div>
        <button class="pill pill-primary press" id="intro-next" type="button">Next</button>
      </footer>
    </section>

    <!-- Waiting for the host to start: the event image in the moment's look, then the facts -->
    <section class="screen waiting" data-screen="waiting">
      <div class="waiting-backdrop" aria-hidden="true">
        <img id="waiting-cover" alt="" hidden />
      </div>
      <button class="round glass press waiting-invite" id="waiting-invite" type="button" aria-label="Invite someone">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h2v2h-2zM18 14h2v2h-2zM14 18h2v2h-2zM18 18h2v2h-2zM16 16h2v2h-2z" /></svg>
      </button>
      <div class="waiting-body">
        <p class="eyebrow" data-bind="event-name"></p>
        <h1>Almost <em>there.</em></h1>
        <div class="wait-row">
          <span class="ping" aria-hidden="true"></span>
          <p>Waiting for <b id="waiting-host">the host</b> to start the event.</p>
        </div>
        <ul class="facts">
          <li>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h3l2-3h6l2 3h3v11H4z" /><circle cx="12" cy="13" r="3.5" /></svg>
            <span id="waiting-roll"></span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
            <span id="waiting-ends"></span>
          </li>
        </ul>
        <p class="fine">Keep this page open. The camera opens by itself.</p>
      </div>
      <div class="waiting-foot">
        <button class="pill pill-ghost press" id="waiting-how" type="button">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 11v5M12 8h.01" /></svg>
          How it works
        </button>
      </div>
    </section>

    <!-- The camera -->
    <section class="screen camera" data-screen="camera">
      <header class="cam-head">
        <p class="cam-title" data-bind="event-name"></p>
        <p class="cam-count" aria-live="polite"><b id="shots-left">–</b> <span>left</span></p>
        <button class="pill pill-glass glass press mission-capsule" id="missions" type="button" hidden></button>
      </header>

      <div class="frame">
        <canvas id="viewfinder" aria-label="Viewfinder"></canvas>
        <div class="veil" id="veil" aria-hidden="true"></div>
        <div class="armed glass" id="armed" hidden>
          <p><span>Next photo:</span> <b id="armed-text"></b></p>
          <button class="armed-clear press" id="armed-clear" type="button" aria-label="Don’t use the next photo for this mission">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7l10 10M17 7 7 17" /></svg>
          </button>
        </div>
        <div class="frame-note" id="frame-note" hidden>
          <p id="frame-note-text"></p>
          <button class="pill pill-glass press" id="frame-note-action" type="button" hidden></button>
        </div>
      </div>

      <div class="cam-row">
        <button class="round glass press absent" id="flash" type="button" aria-label="Flash off" aria-pressed="false">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13 2 4.5 13.5H11L10 22l8.5-11.5H12L13 2z" /></svg>
        </button>
        <button class="pill pill-glass glass press cam-ends" id="ends-in" type="button"></button>
        <button class="round glass press absent" id="flip" type="button" aria-label="Switch camera">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h3l2-3h6l2 3h3v11H4z" /><path d="M9.5 13.5a2.5 2.5 0 0 0 4.6 1.3M14.5 12.5a2.5 2.5 0 0 0-4.6-1.3" /></svg>
        </button>
      </div>

      <div class="cam-bottom">
        <button class="tile glass press" id="my-shots" type="button" aria-label="Your shots">
          <img id="last-shot" alt="" hidden />
        </button>
        <button class="shutter press" id="shutter" type="button" aria-label="Take a photo" disabled>
          <span></span>
        </button>
        <button class="tile glass press" id="invite" type="button" aria-label="Invite someone">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 8a3 3 0 1 0-6 0 3 3 0 0 0 6 0zM4 20c.8-3.5 4-5.5 8-5.5M18 14v6M15 17h6" /></svg>
        </button>
      </div>
    </section>

    <!-- Developing: the roll is used up, or the host or the clock is about to develop -->
    <section class="screen screen-center" data-screen="developing">
      <p class="eyebrow" data-bind="event-name"></p>
      <h1 id="dev-title">Your film is <em>developing.</em></h1>
      <p class="countdown" id="countdown" aria-live="off"></p>
      <p class="lede" id="dev-lede"></p>
      <div class="actions">
        <a class="pill pill-primary press" id="calendar" download>Remind me</a>
        <button class="pill pill-ghost press" id="dev-shots" type="button">Your shots</button>
        <button class="pill pill-ghost press" id="dev-camera" type="button" hidden>Back to the camera</button>
      </div>
    </section>

    <!-- The album -->
    <section class="screen album" data-screen="album">
      <div class="hero" id="hero">
        <img id="hero-img" alt="" />
        <div class="hero-text">
          <h1 data-bind="event-name"></h1>
          <p id="album-counts"></p>
        </div>
      </div>
      <ol class="prints" id="prints"></ol>
      <p class="album-empty lede" id="album-empty" hidden>No photos on this film.</p>
      <footer class="album-foot">
        <p class="fine">Want the next one in your pocket?</p>
        <StoreButtons />
      </footer>
    </section>

    <!-- Something is wrong -->
    <section class="screen screen-center" data-screen="error">
      <h1 id="error-title">This link <em>doesn’t work.</em></h1>
      <p class="lede" id="error-text"></p>
      <button class="pill pill-primary press" id="error-retry" type="button" hidden>Try again</button>
      <a class="text-link" href="/">What is LEFT? →</a>
    </section>

    <!-- The viewer: one photo at a time, swipe sideways -->
    <div class="viewer" id="viewer" role="dialog" aria-modal="true" aria-label="Photo" hidden>
      <div class="viewer-bar">
        <button class="round glass press" id="viewer-close" type="button" aria-label="Close">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
        </button>
        <div class="viewer-title">
          <p id="viewer-caption"></p>
          <p class="viewer-mission" id="viewer-mission" hidden></p>
        </div>
        <span class="round-spacer"></span>
      </div>
      <div class="viewer-track" id="viewer-track"></div>
      <div class="viewer-actions">
        <button class="pill pill-glass glass press" id="viewer-save" type="button">Save</button>
        <button class="pill pill-glass glass press" id="viewer-tag" type="button" hidden>Mission</button>
        <button class="round glass press" id="viewer-delete" type="button" aria-label="Delete photo" hidden>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 7h14M10 7V4h4v3M7 7l1 13h8l1-13" /></svg>
        </button>
        <button class="round glass press" id="viewer-report" type="button" aria-label="Report photo" hidden>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 21V4M6 4h11l-2 4 2 4H6" /></svg>
        </button>
      </div>
    </div>

    <!-- Missions: the list (arm the next shot) or, from Your shots, which mission a photo was for -->
    <div class="mission-sheet" id="mission-sheet" role="dialog" aria-modal="true" aria-labelledby="mission-title" hidden>
      <button class="sheet-scrim" id="mission-scrim" type="button" aria-label="Close" tabindex="-1"></button>
      <div class="sheet glass">
        <h2 id="mission-title">Your <em>missions.</em></h2>
        <p class="lede" id="mission-lede"></p>
        <ul class="mission-list" id="mission-list"></ul>
        <button class="pill pill-primary press" id="mission-done" type="button">Got it</button>
      </div>
    </div>

    <div class="toast glass" id="toast" role="status" aria-live="polite"></div>
    <div class="front-flash" id="front-flash" aria-hidden="true"></div>
  </div>
</Base>

<script>
  import { start } from '../../shoot/app';
  start();
</script>
