---
/**
 * The store listings' pictures: one page per screenshot, plus Google Play's
 * feature graphic and the App Store's two wide pictures (the product page's
 * header and the search result). Not part of the site — the route only exists while
 * STORE_ASSETS is set (astro.config.mjs), and `npm run store` photographs
 * each page into ../store-assets/.
 *
 * Everything is sized in vw/vh, so one page serves every screenshot size;
 * the script picks the size through the viewport. Google Play's pictures use
 * the Android handset (Phone's `device`). No script runs here: the
 * phones use their no-JS path (container units) and stay still.
 */
import '@fontsource-variable/newsreader/wght.css';
import '@fontsource-variable/newsreader/wght-italic.css';
import '@fontsource-variable/inter/wght.css';
import '@fontsource/dm-serif-display/400.css';
import '../styles/global.css';
import { Image } from 'astro:assets';
import Phone from '../components/Phone.astro';
import logo from '../assets/left-logo.png';
import weddingFriends from '../assets/photos/wedding-friends.jpg';
import weddingDance from '../assets/photos/wedding-dance.jpg';
import weddingCrowd from '../assets/photos/wedding-crowd.jpg';
import weddingMono from '../assets/photos/wedding-mono.jpg';
import partyFlash from '../assets/photos/party-flash.jpg';
import partyWine from '../assets/photos/party-wine.jpg';
import birthdayCandle from '../assets/photos/birthday-candle.jpg';
import dinnerCandle from '../assets/photos/dinner-candle.jpg';
import tripTrunk from '../assets/photos/trip-trunk.jpg';
import tripVan from '../assets/photos/trip-van.jpg';
import sample1 from '../assets/photos/sample-1.jpg';
import sample2 from '../assets/photos/sample-2.jpg';
import sample3 from '../assets/photos/sample-3.jpg';
import sample4 from '../assets/photos/sample-4.jpg';
import sample5 from '../assets/photos/sample-5.jpg';
import sample6 from '../assets/photos/sample-6.jpg';
import partyToast from '../assets/photos/party-toast.jpg';
import partyConfetti from '../assets/photos/party-confetti.jpg';
import friendsLaugh from '../assets/photos/friends-laugh.jpg';
import tripSunset from '../assets/photos/trip-sunset.jpg';
import tripSurf from '../assets/photos/trip-surf.jpg';
import tripFriends from '../assets/photos/trip-friends.jpg';
import weddingChampagne from '../assets/photos/wedding-champagne.jpg';
import weddingNight from '../assets/photos/wedding-night.jpg';
import partyDance from '../assets/photos/party-dance.jpg';
import partyFloor from '../assets/photos/party-floor.jpg';
import grandpaDance from '../assets/photos/grandpa-dance.jpg';
import dinnerTable from '../assets/photos/dinner-table.jpg';
import tripCar from '../assets/photos/trip-car.jpg';
import weddingToast from '../assets/photos/wedding-toast.jpg';
import inviteCard from '../assets/photos/invite-card.jpg';
import type { ImageMetadata } from 'astro';

/**
 * No photo appears twice across the eight screenshots (the film picker shows
 * its one photo in the four looks — that is the point of that screen), and
 * every moment's strip is full (the user, 2026-11-18).
 */
const PRINTS = [
  { src: weddingChampagne, by: 'Tom' },
  { src: weddingNight, by: 'Aylin' },
];
const MOMENTS = [
  {
    title: 'Road trip',
    photos: 96,
    people: 7,
    status: 'Developed',
    live: false,
    more: 93,
    strip: [tripTrunk, tripVan, tripSunset, tripSurf],
  },
  {
    title: 'Lena’s 30th',
    photos: 57,
    people: 14,
    status: '01d 04h left',
    live: true,
    more: 0,
    strip: [birthdayCandle, partyConfetti, partyWine, dinnerCandle],
  },
  {
    title: 'Summer ’26',
    photos: 128,
    people: 21,
    status: 'Developed',
    live: false,
    more: 125,
    strip: [sample3, sample4, sample5, tripFriends],
  },
];

/**
 * The eight screenshots, in listing order (docs/LAUNCH.md §10). The headline
 * stands at the top; under it a composition (2026-11-19, the user: "not
 * always just an iPhone from top and bottom"): a phone tilted a few degrees
 * that runs off the bottom edge, sometimes a second phone behind it, and
 * prints that float beside or above it.
 *
 * Every position is in vw, measured from the stage's top-left corner, so the
 * same composition serves the 9:19.5 iPhone and the 9:16 Android picture —
 * the shorter Android picture only cuts the phones a little higher. A
 * phone's `x`/`w` place its frame, `r` tilts it about its centre. A print is
 * a photo on paper: `by` writes who took it on the margin, `mission` hangs
 * the caption the viewer shows, `look` picks the film, `veiled` keeps it
 * undeveloped.
 */
type PhoneSpec = {
  screen: 'camera' | 'looks' | 'moments' | 'album' | 'invite' | 'developing' | 'missions' | 'viewer';
  photo?: ImageMetadata;
  tile?: ImageMetadata;
  mission?: { done: number; total: number; armed?: string };
  viewer?: { by: string; index: number; count: number; mission?: string };
  x: number;
  y: number;
  w: number;
  r: number;
  z?: number;
  /** The 9:16 Android picture is shorter: a phone whose point is low on its screen moves or shrinks there. */
  android?: { x?: number; y?: number; w?: number; r?: number };
};
type PrintSpec = {
  src: ImageMetadata;
  x: number;
  y: number;
  w: number;
  r: number;
  z?: number;
  by?: string;
  mission?: string;
  look?: 'golden' | 'chrome' | 'faded' | 'mono';
  veiled?: boolean;
  android?: { x?: number; y?: number; w?: number; r?: number };
};
type ShotSpec = { lines: [string, string]; glow: string; phones: PhoneSpec[]; prints: PrintSpec[] };

const SHOTS: ShotSpec[] = [
  {
    lines: ['One roll each.', 'Make every shot count.'],
    glow: '85% 30%',
    phones: [{ screen: 'camera', photo: weddingDance, tile: sample1, mission: { done: 1, total: 3 }, x: 6, y: 10, w: 76, r: -6 }],
    prints: [
      { src: partyFloor, x: 63, y: 4, w: 34, r: 9, z: 2, by: 'Jonas' },
      { src: weddingToast, x: 70, y: 52, w: 28, r: -5, z: 2, by: 'Lena' },
    ],
  },
  {
    lines: ['A secret dare', 'in every pocket.'],
    glow: '10% 30%',
    phones: [{ screen: 'missions', photo: partyToast, tile: sample1, mission: { done: 1, total: 3 }, x: 22, y: 8, w: 76, r: 6, android: { x: 34, y: 4, w: 62 } }],
    prints: [{ src: grandpaDance, x: 2, y: 30, w: 42, r: -8, z: 2, by: 'Aylin', mission: 'A dance with the oldest guest', android: { y: 14, w: 38 } }],
  },
  {
    lines: ['The whole night,', 'developed together.'],
    glow: '50% 20%',
    phones: [{ screen: 'album', photo: weddingCrowd, x: 14, y: 26, w: 72, r: -3 }],
    prints: [
      { src: partyDance, x: 2, y: 6, w: 34, r: -12, z: 2, by: 'Marc' },
      { src: sample6, x: 36, y: -2, w: 30, r: 4, z: 1, by: 'Sofia' },
      { src: weddingMono, x: 66, y: 8, w: 32, r: 13, z: 2, by: 'Tom', look: 'mono' },
    ],
  },
  {
    lines: ['Every dare', 'gets its answer.'],
    glow: '15% 40%',
    phones: [
      {
        screen: 'viewer',
        photo: friendsLaugh,
        viewer: { by: 'Marc', index: 87, count: 412, mission: 'A photo with someone you have never met' },
        x: 20,
        y: 8,
        w: 74,
        r: 5,
        android: { x: 32, y: 4, w: 62 },
      },
    ],
    prints: [{ src: partyFlash, x: 1, y: 44, w: 36, r: -10, z: 2, by: 'Nina', mission: 'Catch someone mid-laugh' }],
  },
  {
    lines: ['One scan.', 'Everyone’s in.'],
    glow: '50% 10%',
    phones: [
      { screen: 'camera', photo: sample2, tile: tripCar, x: 44, y: 4, w: 62, r: 10, z: 0 },
      { screen: 'invite', x: 3, y: 14, w: 70, r: -6, z: 1 },
    ],
    prints: [],
  },
  {
    lines: ['Pick the film', 'for your night.'],
    glow: '80% 25%',
    phones: [{ screen: 'looks', photo: weddingFriends, x: 4, y: 12, w: 74, r: -5 }],
    prints: [
      { src: weddingFriends, x: 66, y: 2, w: 31, r: 10, z: 2, look: 'chrome', by: 'Chrome' },
      { src: weddingFriends, x: 69, y: 44, w: 29, r: -6, z: 2, look: 'mono', by: 'Mono' },
    ],
  },
  {
    lines: ['Hidden until', 'it’s over.'],
    glow: '50% 20%',
    phones: [{ screen: 'developing', x: 14, y: 22, w: 72, r: 4 }],
    prints: [
      { src: dinnerTable, x: 0, y: 2, w: 32, r: -11, z: 2, veiled: true, by: 'Developing…' },
      { src: tripCar, x: 66, y: 6, w: 31, r: 9, z: 2, veiled: true, by: 'Developing…' },
    ],
  },
  {
    lines: ['Every event,', 'one album.'],
    glow: '20% 25%',
    phones: [{ screen: 'moments', x: 22, y: 10, w: 74, r: 5 }],
    prints: [
      { src: tripSunset, x: 1, y: 8, w: 34, r: -9, z: 2, by: 'Road trip' },
      { src: birthdayCandle, x: 4, y: 62, w: 30, r: 6, z: 2, by: 'Lena’s 30th' },
    ],
  },
];

export function getStaticPaths() {
  const shots = ['ios', 'android'].flatMap((platform) =>
    Array.from({ length: 8 }, (_, index) => ({ params: { id: `${platform}-${index + 1}` } })),
  );
  return [...shots, ...['feature', 'header', 'search', 'clip'].map((id) => ({ params: { id } }))];
}

const { id } = Astro.params;
const [platform, number] = String(id).split('-');
/** The pictures that are not screenshots: Play's feature graphic, the App Store's banners. */
const wide = platform === 'feature' || platform === 'header' || platform === 'search' || platform === 'clip';
const shot = wide ? null : SHOTS[Number(number) - 1];
const device = platform === 'ios' ? 'iphone' : 'android';
const place = (item: { x: number; y: number; w: number; r: number; z?: number }) =>
  `left:${item.x}vw;top:${item.y}vw;width:${item.w}vw;rotate:${item.r}deg;z-index:${item.z ?? 1}`;
/** Three device pixels per point, and the phone fills most of the picture. */
const DETAIL = 1.2;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Store asset {id}</title>
  </head>
  <body class={platform}>
    {
      shot && (
        <main class="shot" style={`--glow:${shot.glow}`}>
          <h1>
            {shot.lines[0]}
            <br />
            <em>{shot.lines[1]}</em>
          </h1>
          <div class="stage">
            {shot.phones.map((spec) => (
              <div class="ph" style={place(device === 'android' ? { ...spec, ...spec.android } : spec)}>
                <Phone
                  screen={spec.screen}
                  photo={spec.photo}
                  mission={spec.mission}
                  viewer={spec.viewer}
                  tile={spec.tile ?? sample1}
                  prints={PRINTS}
                  moments={MOMENTS}
                  device={device}
                  label=""
                  eager
                  detail={DETAIL}
                />
              </div>
            ))}
            {shot.prints.map((print) => (
              <figure class:list={['print', { veiled: print.veiled }]} style={place(device === 'android' ? { ...print, ...print.android } : print)}>
                <span class="paper">
                  <Image
                    src={print.src}
                    alt=""
                    width={Math.round(print.w * 3 * 4.4)}
                    height={Math.round(print.w * 3 * 4.4 * 1.25)}
                    fit="cover"
                    quality={86}
                    loading="eager"
                    class={`look-${print.look ?? 'golden'}`}
                  />
                </span>
                {print.by && <figcaption>{print.by}</figcaption>}
                {print.mission && (
                  <span class="chip">
                    <svg viewBox="0 0 24 24">
                      <path d="M12 22a10 10 0 100-20 10 10 0 000 20zM12 18a6 6 0 100-12 6 6 0 000 12zM12 14a2 2 0 100-4 2 2 0 000 4z" />
                    </svg>
                    {print.mission}
                  </span>
                )}
              </figure>
            ))}
          </div>
        </main>
      )
    }
    {
      (platform === 'header' || platform === 'search') && (
        <main class:list={['banner', platform]}>
          <Phone screen="camera" photo={partyDance} tile={sample6} device="iphone" label="" eager detail={DETAIL} class="left" />
          <div class="copy">
            <p class="brand">
              <Image src={logo} alt="" width={96} height={96} loading="eager" />
              <span>LEFT</span>
            </p>
            <h1>
              One roll each.
              <br />
              <em>Developed together.</em>
            </h1>
            <p class="sub">The disposable camera for events</p>
          </div>
          <Phone screen="album" photo={weddingMono} prints={PRINTS} device="iphone" label="" eager detail={DETAIL} class="right" />
        </main>
      )
    }
    {
      platform === 'feature' && (
        <main class="feature">
          <div class="copy">
            <p class="brand">
              <Image src={logo} alt="" width={96} height={96} loading="eager" />
              <span>LEFT</span>
            </p>
            <h1>
              One roll each.
              <br />
              <em>Developed together.</em>
            </h1>
            <p class="sub">The disposable camera for events</p>
          </div>
          <div class="phones">
            <Phone screen="album" photo={partyFlash} prints={PRINTS} device="android" label="" eager detail={DETAIL} class="back" />
            <Phone screen="camera" photo={weddingDance} tile={sample2} device="android" label="" eager detail={DETAIL} class="front" />
          </div>
        </main>
      )
    }
    {
      /*
        The App Clip card's header (1800x1200, the size Apple requires): the first thing a guest sees
        after scanning an invite without the app. A blank card on linen
        between eucalyptus (the user's photo, 2026-11-19) with "You’re on the
        list." and a heart written on it, as if by hand. The card prints the clip's name,
        the subtitle and the button under the image.
      */
      platform === 'clip' && (
        <main class="clip">
          <Image src={inviteCard} alt="" width={2000} height={1333} quality={92} loading="eager" class="linen" />
          <div class="note">
            <p>
              You’re
              <br />
              on the list.
            </p>
            <svg viewBox="0 0 64 58" aria-hidden="true">
              <path d="M32 54C24 47 6 36 4.5 21.5 3.4 11 10.5 4 18.5 4.6c6.2.5 10.6 4.6 13.4 10.6C34.6 9 39.6 4.4 46.6 4.2 55 4 61 11 59.6 21c-1.9 13.6-17.4 23.6-27.8 33.4" />
            </svg>
          </div>
        </main>
      )
    }
  </body>
</html>

<style is:global>
  html,
  body {
    width: 100vw;
    height: 100vh;
    overflow: hidden;
  }

  /* The site caps a phone at 300px and animates it; here it fills its stage. */
  .phone {
    max-width: none !important;
  }

  .phone .veil {
    display: none;
  }

</style>

<style>
  /* ── A screenshot: the line, and a composition under it ─────────── */
  .shot {
    width: 100vw;
    height: 100vh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    background:
      radial-gradient(110vw 110vw at var(--glow), rgba(240, 190, 140, 0.24), transparent 62%),
      var(--bg);
  }

  h1 {
    font-family: var(--serif);
    font-weight: 300;
    letter-spacing: -0.015em;
    text-align: center;
    color: var(--ink);
  }

  .shot h1 {
    position: relative;
    z-index: 5;
    flex: none;
    font-size: 10.8vw;
    line-height: 1.1;
    padding: 7.4vh 0 3vh;
  }

  .stage {
    position: relative;
    flex: 1;
    width: 100%;
  }

  .ph,
  .print {
    position: absolute;
    margin: 0;
  }

  .ph :global(.phone) {
    width: 100%;
  }

  /* A print: the photo on off-white paper, who took it on the margin. */
  .print {
    filter: drop-shadow(0 2.4vw 3.2vw rgba(0, 0, 0, 0.6));
  }

  .paper {
    display: block;
    padding: 1.5vw 1.5vw 7vw;
    border-radius: 1vw;
    background: var(--ink);
  }

  .paper :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 0.4vw;
  }

  .print figcaption {
    position: absolute;
    left: 2.4vw;
    right: 2.4vw;
    bottom: 1.6vw;
    font-family: var(--serif);
    font-style: italic;
    font-size: 4vw;
    line-height: 1;
    color: #2a2622;
    white-space: nowrap;
    overflow: hidden;
  }

  /* The viewer's mission caption, hung under the print as a glass capsule. */
  .chip {
    position: absolute;
    left: 50%;
    top: calc(100% - 1.2vw);
    translate: -50% 0;
    display: flex;
    align-items: center;
    gap: 1.4vw;
    width: max-content;
    max-width: 62vw;
    padding: 1.8vw 3.2vw;
    border-radius: 99vw;
    background: rgba(28, 26, 24, 0.86);
    border: 0.25vw solid rgba(240, 237, 232, 0.16);
    font-family: var(--sans);
    font-size: 3.1vw;
    font-weight: 500;
    color: var(--ink);
  }

  .chip svg {
    flex: none;
    width: 3.6vw;
    height: 3.6vw;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }

  /* Not developed yet: the paper is dark and the picture is only a glow. */
  .veiled .paper {
    background: #1c1a18;
    overflow: hidden;
  }

  .veiled figcaption {
    color: var(--ink-70);
  }

  .veiled .paper :global(img) {
    filter: blur(1.7vw) brightness(0.6) saturate(0.75);
    transform: scale(1.15);
  }

  /* 9:16 is shorter than an iPhone's 9:19.5: a smaller line, less air. */
  .android .shot h1 {
    font-size: 9.6vw;
    padding: 5.6vh 0 2.4vh;
  }

  /* ── The App Clip card's header, 1800x1200 ───────────────────────── */
  .clip {
    position: relative;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
    background: #f2f0eb;
  }

  .clip :global(.linen) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Written on the card: the card's centre is at 49.6% / 47.4% of the photo. */
  .note {
    position: absolute;
    left: 49.6%;
    top: 47.4%;
    translate: -50% -50%;
    rotate: -2deg;
    display: flex;
    align-items: flex-end;
    gap: 1.6vw;
    color: #2b2723;
    mix-blend-mode: multiply;
    opacity: 0.92;
  }

  .note p {
    margin: 0;
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: 7.6vw;
    line-height: 1.04;
    text-align: center;
    letter-spacing: -0.01em;
  }

  .note svg {
    width: 3.8vw;
    height: auto;
    margin-bottom: 1.2vw;
    rotate: 10deg;
    fill: none;
    stroke: #8e2f22;
    stroke-width: 3.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ── Google Play's feature graphic, 1024x500 ───────────────────── */
  .feature {
    position: relative;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
    display: flex;
    align-items: center;
    padding-left: 7vw;
    background:
      radial-gradient(70vw 70vw at 78% 10%, rgba(240, 190, 140, 0.26), transparent 62%),
      var(--bg);
  }

  .copy {
    display: grid;
    gap: 2.2vw;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 1.1vw;
    font-weight: 600;
    font-size: 2.3vw;
    letter-spacing: 0.08em;
  }

  .brand :global(img) {
    width: 3vw;
    height: 3vw;
  }

  .feature h1 {
    text-align: left;
    font-size: 5.6vw;
    line-height: 1.08;
  }

  .sub {
    font-size: 1.9vw;
    color: var(--ink-70);
  }

  .phones {
    position: absolute;
    inset: 0 0 0 56vw;
  }

  .phones :global(.phone) {
    position: absolute;
    width: 21vw;
  }

  .phones :global(.back) {
    left: 20vw;
    top: 16vh;
    rotate: 7deg;
  }

  .phones :global(.front) {
    left: 2vw;
    top: 9vh;
    rotate: -5deg;
  }

  /*
    ── The App Store's wide pictures: the product page's header (3840x1646)
    and the search result (3840x2560). The store crops both towards the middle
    on narrow screens, so the brand and the line sit in the centre and the two
    phones at the sides are what may be lost.
  */
  .banner {
    position: relative;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
    display: grid;
    place-items: center;
    background:
      radial-gradient(60vw 60vw at 50% -10%, rgba(240, 190, 140, 0.28), transparent 62%),
      var(--bg);
  }

  .banner .copy {
    justify-items: center;
    text-align: center;
  }

  .banner h1 {
    font-size: 4.4vw;
    line-height: 1.08;
  }

  .banner :global(.phone) {
    position: absolute;
    width: 17vw;
    top: 15vh;
  }

  .banner :global(.left) {
    left: 5vw;
    rotate: -6deg;
  }

  .banner :global(.right) {
    right: 5vw;
    rotate: 6deg;
  }

  /* 3:2 is taller: larger phones that fit whole, and a larger line. */
  .banner.search h1 {
    font-size: 4.8vw;
  }

  .banner.search :global(.phone) {
    width: 23vw;
    top: 13vh;
  }

  .banner.search :global(.left) {
    left: 2.5vw;
  }

  .banner.search :global(.right) {
    right: 2.5vw;
  }
</style>
