# The web camera at /j/{CODE} talks to the same Supabase project as the app.
# Copy to web/.env for `npm run dev`; on Cloudflare Pages set both as build
# environment variables. Without them the invite page says the camera is not
# switched on. The publishable (anon) key is public by design — RLS is the guard.
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
